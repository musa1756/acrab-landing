---
import Icon from "./Icon.astro";

interface Props {
  /** Абсолютный путь к файлу в public/assets/audio/. */
  src: string;
  /** Что звучит, например «шукран»: попадает в подпись кнопки для скринридера. */
  label: string;
  /** Крупная кнопка шапки фразы (Speak prominent: 66 pt); без неё — маленькая рядом со словом (28 pt). */
  large?: boolean;
}

const { src, label, large = false } = Astro.props;
---

<button type="button" class:list={["audio-btn", { "audio-btn-large": large }]} data-audio={src} aria-label={`Слушать: ${label}`} title="Слушать" hidden>
  <Icon name="speaker-high" />
</button>
<script src="../scripts/phrase-audio.ts"></script>
