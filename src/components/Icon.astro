---
import { PHOSPHOR, type PhosphorName } from "../lib/phosphor";

interface Props {
  name: PhosphorName;
  /** Подпись для чтения с экрана; без неё значок декоративный. */
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 256 256" fill="currentColor" focusable="false" aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label} set:html={PHOSPHOR[name]} />
