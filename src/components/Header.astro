---
import { SECTIONS, SERVICE_NAVS, type SectionId, type ServiceNav } from "../lib/routes";

interface Props {
  active?: SectionId | undefined;
  /** Короткая шапка служебной страницы; по умолчанию — разделы сайта. */
  variant?: ServiceNav | undefined;
  /** Плавающая плашка с кнопкой «Скачать» (главная). */
  floating?: boolean | undefined;
}

const { active, variant, floating = false } = Astro.props;
const links = variant ? SERVICE_NAVS[variant] : SECTIONS;
---

<header class:list={["site-header", { "site-header-floating": floating }]}>
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label="Acrab, на главную">
      <img src="/assets/acrab-icon-64.png" alt="" width="30" height="30" />
      <span>Acrab</span>
    </a>
    <nav class="site-nav" aria-label="Разделы сайта">
      {links.map((link) => (
        <a href={link.href} aria-current={active === link.id ? "page" : undefined}>{"short" in link && link.short ? (<Fragment><span class="nav-full">{link.label}</span><span class="nav-short">{link.short}</span></Fragment>) : link.label}</a>
      ))}
    </nav>
    {floating && <a class="btn btn-dense site-header-cta" href="/get/">Скачать</a>}
  </div>
</header>

<script src="../scripts/site-nav.ts"></script>
