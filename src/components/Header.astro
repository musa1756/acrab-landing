---
interface Props {
  active?: "home" | "articles" | "keyboard" | "updates" | "buy" | "support";
  variant?: "primary" | "offer" | "consent" | "get";
}

const { active, variant = "primary" } = Astro.props;
const linkSets = {
  primary: [
    { id: "home", href: "/", label: "О приложении", short: "Главная" },
    { id: "updates", href: "/about/", label: "Обновления" },
    { id: "buy", href: "/buy/", label: "Оплата" },
    { id: "articles", href: "/articles/", label: "Статьи" },
    { id: "keyboard", href: "/arabic-keyboard/", label: "Клавиатура" },
    { id: "support", href: "/support/", label: "Помощь" },
  ],
  offer: [
      { id: "buy", href: "/buy/", label: "Оплата" },
      { id: "support", href: "/support/", label: "Помощь" },
      { id: "privacy", href: "/privacy/", label: "Конфиденциальность" },
  ],
  consent: [
      { id: "buy", href: "/buy/", label: "Оплата" },
      { id: "privacy", href: "/privacy/", label: "Конфиденциальность" },
  ],
  get: [
      { id: "home", href: "/", label: "О приложении" },
      { id: "support", href: "/support/", label: "Помощь" },
  ],
} as const;
const links = linkSets[variant];
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/" aria-label="Acrab, на главную">
      <img src="/assets/acrab-icon-64.png" alt="" width="30" height="30" />
      <span>Acrab</span>
    </a>
    <nav class="site-nav" aria-label="Разделы сайта">
      {links.map((link) => (
        <a href={link.href} aria-current={active === link.id ? "page" : undefined}>{"short" in link ? (<Fragment><span class="nav-full">{link.label}</span><span class="nav-short">{link.short}</span></Fragment>) : link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script src="../scripts/site-nav.ts"></script>
