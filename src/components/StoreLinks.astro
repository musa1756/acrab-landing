---
import { APP_STORE_PAGE_URL, GOOGLE_PLAY_URL, RUSTORE_URL } from "../lib/stores";

/* Три магазина — одни и те же кнопки на всех страницах: в подвале, в призыве
   статей, на главной и на /get. Цвет кнопки берётся из base.css по адресу. */
interface Props {
  centered?: boolean;
  class?: string;
}

const { centered = false, class: className } = Astro.props;
const stores = [
  { href: APP_STORE_PAGE_URL, kicker: "Загрузите в", name: "App Store", label: "Скачать Acrab в App Store для iPhone и iPad", icon: "M17.05 12.53c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.71-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.21 1.1-.05 1.52-.72 2.85-.72 1.33 0 1.71.72 2.88.69 1.19-.02 1.94-1.08 2.67-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.54zM14.87 6.09c.61-.74 1.02-1.77.91-2.79-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.7-.92 2.7.98.08 1.98-.5 2.58-1.23z" },
  { href: RUSTORE_URL, kicker: "Доступно в", name: "RuStore", label: "Скачать Acrab в RuStore для Android", icon: "M17.6 9.48l1.84-3.18a.38.38 0 0 0-.14-.52.38.38 0 0 0-.52.14l-1.87 3.23a11.43 11.43 0 0 0-9.82 0L5.22 5.92a.38.38 0 0 0-.52-.14.38.38 0 0 0-.14.52L6.4 9.48A10.81 10.81 0 0 0 1 18h22a10.81 10.81 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z" },
  { href: GOOGLE_PLAY_URL, kicker: "Доступно в", name: "Google Play", label: "Скачать Acrab в Google Play для Android", icon: "M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z" },
];
---

<div class:list={[className, "store-links", { "store-links-centered": centered }]} aria-label="Скачать Acrab">
  {stores.map((store) => (
    <a class="store-link" href={store.href} target="_blank" rel="noopener" aria-label={store.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={store.icon} /></svg>
      <span class="store-link-text"><span class="store-link-kicker">{store.kicker}</span><span class="store-link-name">{store.name}</span></span>
    </a>
  ))}
</div>
