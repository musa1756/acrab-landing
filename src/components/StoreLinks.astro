---
import { APP_STORE_PAGE_URL, GOOGLE_PLAY_URL, RUSTORE_URL, STORE_GLYPHS } from "../lib/stores";

/* Три магазина — одни и те же кнопки на всех страницах: в подвале, в призыве
   статей, на главной и на /get. Цвет кнопки берётся из base.css по адресу. */
interface Props {
  centered?: boolean;
  class?: string;
}

const { centered = false, class: className } = Astro.props;
const stores = [
  { href: APP_STORE_PAGE_URL, kicker: "Загрузите в", name: "App Store", label: "Скачать Acrab в App Store для iPhone и iPad", icon: STORE_GLYPHS["App Store"] },
  { href: RUSTORE_URL, kicker: "Доступно в", name: "RuStore", label: "Скачать Acrab в RuStore для Android", icon: STORE_GLYPHS["RuStore"] },
  { href: GOOGLE_PLAY_URL, kicker: "Доступно в", name: "Google Play", label: "Скачать Acrab в Google Play для Android", icon: STORE_GLYPHS["Google Play"] },
];
---

<div class:list={[className, "store-links", { "store-links-centered": centered }]} aria-label="Скачать Acrab">
  {stores.map((store) => (
    <a class="store-link" href={store.href} target="_blank" rel="noopener" aria-label={store.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={store.icon} /></svg>
      <span class="store-link-text"><span class="store-link-kicker">{store.kicker}</span><span class="store-link-name">{store.name}</span></span>
    </a>
  ))}
</div>
