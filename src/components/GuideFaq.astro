---
import { richArabic } from "../lib/rich-arabic";
import { faqSchema, type FaqItem } from "../seo/schema";

interface Props {
  items: FaqItem[];
  title?: string;
}

// Вопросы на странице и FAQPage в разметке строятся из одного списка,
// поэтому разойтись не могут.
const { items, title = "Частые вопросы" } = Astro.props;
---

<section id="faq">
  <h2>{title}</h2>
  <div class="guide-faq card card-plain" data-appear>
    {items.map((item) => (
      <div><h3 set:html={richArabic(item.question)} /><p set:html={richArabic(item.answer)} /></div>
    ))}
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema(items))} />
</section>
