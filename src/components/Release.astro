---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props {
  release: CollectionEntry<"changelog">;
}

const { release } = Astro.props;
const { data } = release;
const titleId = `${release.id}-title`;
const sections = [
  { label: "Новое", emoji: "✨", items: data.new },
  { label: "Улучшения", emoji: "💎", items: data.improvements },
  { label: "Исправления", emoji: "🐞", items: data.fixes },
];
---

<article class="release" id={release.id} aria-labelledby={titleId} data-appear>
  <div class="release-head">
    <a class="chip version-chip" href={`#${release.id}`}>{data.version}</a>
    <time class="release-date" datetime={data.date.toISOString().slice(0, 10)}>{data.dateLabel}</time>
  </div>
  <h2 class="release-title t-title" id={titleId}>{data.title}</h2>
  {data.image ? (
    <figure class="release-media">
      <img src={data.image.src} alt={data.image.alt} width={data.image.width} height={data.image.height} />
    </figure>
  ) : (
    <div class="release-media media-placeholder" role="img" aria-label="Изображение обновления пока не добавлено">
      <span class="icon-badge icon-badge-large"><Icon name="image" /></span>
    </div>
  )}
  <div class="release-body">
    {data.description.map((paragraph) => <p set:html={paragraph} />)}
    {sections.map((section) => section.items.length > 0 && (
      <section class="release-section">
        <h3 class="section-head"><span class="emoji" aria-hidden="true">{section.emoji}</span>{section.label}</h3>
        <ul class="note-list">{section.items.map((item) => <li set:html={item} />)}</ul>
      </section>
    ))}
  </div>
</article>
