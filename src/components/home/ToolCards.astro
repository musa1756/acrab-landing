---
/**
 * Девять инструментов: горизонтальная лента цветных карточек (привязка к
 * краю, листается пальцем и колёсиком). Описания — те же, что в приложении
 * (ToolsScreen.tsx): названия, числа и ограничения не менять без сверки.
 */
const TOOLS = [
  { tone: "purple", name: "Перевод", text: "Арабский и русский, язык определяется сам. Каждое слово можно нажать.", src: "tool-translate", w: 620, h: 988, alt: "Переводчик: русская фраза и её арабский перевод с огласовками" },
  { tone: "orange", name: "Огласовки", text: "Вставьте текст или фото, и приложение расставит все огласовки.", src: "tool-tashkeel", w: 620, h: 1252, alt: "Огласовки: фраза без огласовок и тот же текст с полным ташкилем" },
  { tone: "blue", name: "Озвучка", text: "Фраза превращается в аудио с переводом. Звучащее слово подсвечивается.", src: "tool-tts", w: 620, h: 1212, alt: "Озвучка: фраза, волна звука и пословная подсветка" },
  { tone: "pink", name: "Слова по теме", text: "Тема превращается в 15 слов с переводом, «Ещё слова» добавляет следующие.", src: "tool-vocab", w: 620, h: 1252, alt: "Слова по теме «Путешествия»: слова с переводом и частью речи" },
  { tone: "green", name: "Примеры", text: "Пять фраз со словом в разных ситуациях, у каждой перевод и озвучка.", src: "tool-examples", w: 620, h: 1212, alt: "Примеры: слово «пчела» в разных ситуациях с переводом и озвучкой" },
  { tone: "gold", name: "Картинка", text: "Введите слово, и откроется акварельная карточка с подписью по-арабски.", src: "tool-image", w: 620, h: 1252, alt: "Картинка к слову «гранат»: акварельная карточка с арабским словом" },
  { tone: "purple", name: "Анки", text: "Повторяйте свои слова карточками: вправо — знаю, влево — не знаю.", src: "tool-anki", w: 620, h: 1252, alt: "Анки: карточка с глаголом и кнопки «Знаю» и «Не знаю»" },
  { tone: "orange", name: "Спряжение", text: "Больше 1 200 глаголов, в прошедшем и настоящем времени по 14 форм.", src: "tool-conjugation", w: 620, h: 1196, alt: "Спряжение глагола قَرَأَ в настоящем времени, 14 форм" },
  { tone: "blue", name: "Семья слов", text: "Корень и слова от него: глаголы пород I–X, масдар, имена деятеля и объекта.", src: "tool-root", w: 620, h: 1196, alt: "Семья слов: корень ك-ت-ب и производные — глагол, масдар, деятель, объект" },
] as const;
---

<div class="tc" role="region" aria-label="Инструменты Acrab, листаются по горизонтали" tabindex="0">
  <ul class="tc-track" role="list">
    {TOOLS.map((t) => (
      <li class={`tc-card tone-${t.tone}`}>
        <h3 class="tc-name">{t.name}</h3>
        <p class="tc-text">{t.text}</p>
        <img class="tc-shot" src={`/assets/about/${t.src}.webp`} alt={t.alt} width={t.w} height={t.h} loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</div>
