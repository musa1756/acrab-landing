---
import Icon from "../Icon.astro";
import { APP_STORE_PAGE_URL, GOOGLE_PLAY_URL } from "../../lib/stores";
import { STORE_RATINGS, STORE_REVIEWS, type ReviewStore, type StoreReview } from "../../data/store-reviews";

/* Отзывы из магазинов: сводка по двум магазинам и бегущая лента карточек.
   Тексты и имена лежат в data/store-reviews.ts дословно. Лента — две одинаковые
   дорожки подряд, сдвиг на половину ширины даёт бесшовную петлю; вторая
   дорожка скрыта от чтения с экрана. Движение — только CSS (reviews.css);
   reviews.ts ставит на паузу вне экрана и по кнопке. */

const MONTHS = [
  "января", "февраля", "марта", "апреля", "мая", "июня",
  "июля", "августа", "сентября", "октября", "ноября", "декабря",
];

function formatDate(iso: string): string {
  const [year, month, day] = iso.split("-").map(Number);
  return `${day} ${MONTHS[(month ?? 1) - 1] ?? ""} ${year}`;
}

function formatRating(rating: number): string {
  return rating.toFixed(1).replace(".", ",");
}

/* Короткий отзыв набирается крупнее, чтобы карточка не пустовала. */
function sizeOf(review: StoreReview): "lg" | "md" | "sm" {
  const length = Array.from(review.text).length;
  if (!review.title && length <= 60) return "lg";
  return length <= 120 ? "md" : "sm";
}

function initial(name: string): string {
  return (Array.from(name.trim())[0] ?? "").toUpperCase();
}

/* Значки магазинов — те же контуры, что в StoreLinks. */
const STORES: Record<ReviewStore, { href: string; glyph: string }> = {
  "App Store": {
    href: APP_STORE_PAGE_URL,
    glyph: "M17.05 12.53c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.71-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.21 1.1-.05 1.52-.72 2.85-.72 1.33 0 1.71.72 2.88.69 1.19-.02 1.94-1.08 2.67-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.54zM14.87 6.09c.61-.74 1.02-1.77.91-2.79-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.7-.92 2.7.98.08 1.98-.5 2.58-1.23z",
  },
  "Google Play": {
    href: GOOGLE_PLAY_URL,
    glyph: "M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z",
  },
};

const STARS = [1, 2, 3, 4, 5];
const LABEL_STOP = "Остановить ленту отзывов";
const LABEL_PLAY = "Продолжить ленту отзывов";
---

<section class="about-section rv" id="reviews" aria-labelledby="reviews-title">
  <div class="about-section-head" data-appear>
    <h2 class="about-h" id="reviews-title">Что пишут в App Store и Google Play</h2>
    <p class="about-p">Отзывы со страниц приложения в магазинах — дословно, без правок.</p>
  </div>

  <div class="rv-bar" data-appear>
    <ul class="rv-scores" role="list">
      {STORE_RATINGS.map((item) => (
        <li>
          <a class="tile tile-neutral rv-score" href={STORES[item.store].href} target="_blank" rel="noopener" aria-label={`Acrab в ${item.store}: оценка ${formatRating(item.rating)} из 5`}>
            <svg class="rv-score-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={STORES[item.store].glyph} /></svg>
            <span class="rv-score-text">
              <span class="rv-score-name">{item.store}</span>
              <span class="rv-score-line">
                <strong class="rv-score-num">{formatRating(item.rating)}</strong>
                <span class="rv-stars" aria-hidden="true">{STARS.map(() => <Icon name="star" />)}</span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="rv-frame" data-appear>
    <div class="rv-marquee" role="region" aria-label="Лента отзывов из магазинов" tabindex="0">
      <div class="rv-track">
        {[false, true].map((clone) => (
          <ul class="rv-set" role={clone ? undefined : "list"} aria-hidden={clone ? "true" : undefined} inert={clone}>
            {STORE_REVIEWS.map((review) => (
              <li class="rv-card">
                <div class="rv-card-head">
                  <span class="rv-avatar" aria-hidden="true">{initial(review.author)}</span>
                  <div class="rv-who">
                    <p class="rv-author">{review.author}</p>
                    <span class="rv-stars" role="img" aria-label={`Оценка ${review.rating} из 5`}>{STARS.slice(0, review.rating).map(() => <Icon name="star" />)}</span>
                  </div>
                </div>
                {review.title && <p class="rv-title">{review.title}</p>}
                <p class={`rv-text rv-text-${sizeOf(review)}`}>{review.text}</p>
                <p class="rv-meta">
                  <span>{review.store}</span>
                  <span aria-hidden="true">·</span>
                  <time datetime={review.date}>{formatDate(review.date)}</time>
                </p>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>

  <div class="rv-controls">
    <button class="icon-btn rv-toggle" type="button" hidden aria-label={LABEL_STOP} data-label-stop={LABEL_STOP} data-label-play={LABEL_PLAY}>
      <Icon name="pause" class="rv-ico-pause" />
      <Icon name="play" class="rv-ico-play" />
    </button>
  </div>
</section>

<script src="../../scripts/reviews.ts"></script>
