---
/**
 * Карта арабского мира из точек: 22 страны Лиги арабских государств золотом,
 * остальная суша серым, море пустое. Данные — src/data/arabic-world-dots.ts
 * (строит tools/build-arabic-world-dots.ts). Подсветка, плашка с названием и
 * волна появления — scripts/world-map.ts; без скрипта карта и чипы просто видны.
 *
 * Каждая страна — один <path> в <defs>; на экране он нарисован дважды через <use>:
 * золотыми точками и невидимой широкой линией-мишенью для наведения.
 * Классы блока начинаются с `wm-`.
 */
import { WORLD_DOTS } from "../../data/arabic-world-dots";

/** Название и порядок чипов — как у Лиги арабских государств в брифе. */
const LEAGUE = [
  { id: "ma", ru: "Марокко", ar: "الْمَغْرِبُ" },
  { id: "dz", ru: "Алжир", ar: "الْجَزَائِرُ" },
  { id: "tn", ru: "Тунис", ar: "تُونِسُ" },
  { id: "ly", ru: "Ливия", ar: "لِيبِيَا" },
  { id: "eg", ru: "Египет", ar: "مِصْرُ" },
  { id: "sd", ru: "Судан", ar: "السُّودَانُ" },
  { id: "mr", ru: "Мавритания", ar: "مُورِيتَانِيَا" },
  { id: "so", ru: "Сомали", ar: "الصُّومَالُ" },
  { id: "dj", ru: "Джибути", ar: "جِيبُوتِي" },
  { id: "km", ru: "Коморы", ar: "جُزُرُ الْقَمَرِ" },
  { id: "sa", ru: "Саудовская Аравия", ar: "السُّعُودِيَّةُ" },
  { id: "ye", ru: "Йемен", ar: "الْيَمَنُ" },
  { id: "om", ru: "Оман", ar: "عُمَانُ" },
  { id: "ae", ru: "ОАЭ", ar: "الْإِمَارَاتُ" },
  { id: "qa", ru: "Катар", ar: "قَطَرُ" },
  { id: "bh", ru: "Бахрейн", ar: "الْبَحْرَيْنُ" },
  { id: "kw", ru: "Кувейт", ar: "الْكُوَيْتُ" },
  { id: "iq", ru: "Ирак", ar: "الْعِرَاقُ" },
  { id: "sy", ru: "Сирия", ar: "سُورِيَا" },
  { id: "lb", ru: "Ливан", ar: "لُبْنَانُ" },
  { id: "jo", ru: "Иордания", ar: "الْأُرْدُنُّ" },
  { id: "ps", ru: "Палестина", ar: "فِلَسْطِينُ" },
] as const;

const geometry = new Map<string, (typeof WORLD_DOTS.countries)[number]>(WORLD_DOTS.countries.map((country) => [country.id, country]));
const countries = LEAGUE.map((entry) => ({ ...entry, dots: geometry.get(entry.id)! }));
const { cols, rows } = WORLD_DOTS;
/** Страна из нескольких точек на карте почти не видна — ей рисуются точки покрупнее. */
const TINY = 4;
---

<section class="about-section wm" id="arabic-world" aria-labelledby="arabic-world-title" data-wm>
  <div class="about-section-head" data-appear>
    <h2 class="about-h" id="arabic-world-title">Один литературный язык для 22 стран</h2>
    <p class="about-p">Арабский — официальный язык всех 22 стран Лиги арабских государств, от Марокко до Омана. Разговорные диалекты в них разные, а литературный арабский — <a href="/fusha/">фусха</a> — общий: на нём пишут книги и документы, на нём говорят в новостях. Его и учит Acrab.</p>
  </div>

  <div class="wm-stage">
    <div class="wm-map card card-plain" data-appear>
      <div class="wm-canvas" data-wm-canvas>
        <svg
          class="wm-svg"
          viewBox={`-0.5 -0.5 ${cols} ${rows}`}
          role="img"
          aria-label="Карта из точек: 22 страны Лиги арабских государств, от Марокко до Омана и Коморских островов, отмечены золотом. Список стран рядом с картой."
          focusable="false"
        >
          <defs>
            {countries.map(({ id, dots }) => <path id={`wm-d-${id}`} d={dots.d} fill="none" />)}
          </defs>
          <g class="wm-land" data-wm-land>
            {WORLD_DOTS.land.map((d) => <path class="wm-band" d={d} />)}
          </g>
          <use class="wm-halo" data-wm-halo />
          <g class="wm-league">
            {countries.map(({ id, dots }) => (
              <use href={`#wm-d-${id}`} class:list={["wm-country", dots.n <= TINY && "is-tiny"]} data-wm-id={id} />
            ))}
          </g>
          <g class="wm-targets">
            {countries.map(({ id }) => <use href={`#wm-d-${id}`} class="wm-hit" data-wm-id={id} />)}
          </g>
        </svg>
        <div class="wm-plate card" data-wm-plate aria-hidden="true">
          <span class="wm-plate-ru" data-wm-plate-ru></span>
          <span class="wm-plate-ar" lang="ar" dir="rtl" data-wm-plate-ar></span>
        </div>
      </div>
    </div>

    <div class="wm-side">
      <p class="t-group wm-hint">Нажмите на страну, чтобы найти её на карте.</p>
      <ul class="wm-chips" aria-label="Страны Лиги арабских государств">
        {countries.map(({ id, ru, ar, dots }) => (
          <li>
            <span
              class="chip wm-chip"
              data-wm-id={id}
              data-ru={ru}
              data-ar={ar}
              data-ax={dots.ax}
              data-ay={dots.ay}
              data-ty={dots.ty}
              data-by={dots.by}
            >
              <span class="wm-chip-ru">{ru}</span>
              <span class="wm-chip-ar" lang="ar" dir="rtl">{ar}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script src="../../scripts/world-map.ts"></script>
