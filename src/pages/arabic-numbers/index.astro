---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { richArabic } from "../../lib/rich-arabic";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Цифры и числа на арабском от 0 до 100: таблица и счёт | Acrab",
  "description": "Арабские и восточные цифры ٠–٩, числа от 0 до 100 с огласовками, направление записи чисел в тексте справа налево и правила согласования с существительными.",
  "ogTitle": "Цифры и числа на арабском от 0 до 100",
  "ogDescription": "Таблица цифр ٠–٩ и чисел 0–100 с огласовками, порядок записи цифр и точные правила счёта с существительными.",
  "ogImage": "https://acrab.ru/assets/about/lesson-theory.webp",
  "ogImageAlt": "Учебный экран с арабскими словами и огласовками в Acrab"
} as const;

const guide: GuideMeta = {
  headline: "Цифры и числа на арабском от 0 до 100: таблица и правила счёта",
  description: seo.description,
  path: "/arabic-numbers/",
  image: seo.ogImage,
  datePublished: "2026-11-24",
  dateModified: "2026-11-24",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Цифры и числа на арабском", path: "/arabic-numbers/" },
  ],
};

const zeroToTen = [
  ["0", "٠", "صِفْرٌ", "сыфрун", "—"],
  ["1", "١", "وَاحِدٌ", "вахидун", "وَاحِدَةٌ (вахидатун)"],
  ["2", "٢", "اثْنَانِ", "иснани", "اثْنَتَانِ (иснатани)"],
  ["3", "٣", "ثَلَاثَةٌ", "салясатун (с м.р.)", "ثَلَاثٌ (салясун — с ж.р.)"],
  ["4", "٤", "أَرْبَعَةٌ", "арбаатун (с м.р.)", "أَرْبَعٌ (арбаун — с ж.р.)"],
  ["5", "٥", "خَمْسَةٌ", "хамсатун (с м.р.)", "خَمْسٌ (хамсун — с ж.р.)"],
  ["6", "٦", "سِتَّةٌ", "ситтатун (с м.р.)", "سِتٌّ (ситтун — с ж.р.)"],
  ["7", "٧", "سَبْعَةٌ", "сабатун (с м.р.)", "سَبْعٌ (сабун — с ж.р.)"],
  ["8", "٨", "ثَمَانِيَةٌ", "саманиятун (с м.р.)", "ثَمَانٍ / ثَمَانِي (с ж.р.)"],
  ["9", "٩", "تِسْعَةٌ", "тисатун (с м.р.)", "تِسْعٌ (тисун — с ж.р.)"],
  ["10", "١٠", "عَشَرَةٌ", "ашаратун (с м.р.)", "عَشْرٌ (ашрун — с ж.р.)"],
] as const;

const elevenToNineteen = [
  ["11", "١١", "أَحَدَ عَشَرَ", "إِحْدَى عَشْرَةَ", "ахада ашара / ихда ашрата"],
  ["12", "١٢", "اثْنَا عَشَرَ", "اثْنَتَا عَشْرَةَ", "исна ашара / исната ашрата"],
  ["13", "١٣", "ثَلَاثَةَ عَشَرَ", "ثَلَاثَ عَشْرَةَ", "салясата ашара / саляса ашрата"],
  ["14", "١٤", "أَرْبَعَةَ عَشَرَ", "أَرْبَعَ عَشْرَةَ", "арбаата ашара / арбаа ашрата"],
  ["15", "١٥", "خَمْسَةَ عَشَرَ", "خَمْسَ عَشْرَةَ", "хамсата ашара / хамса ашрата"],
  ["16", "١٦", "سِتَّةَ عَشَرَ", "سِتَّ عَشْرَةَ", "ситтата ашара / ситта ашрата"],
  ["17", "١٧", "سَبْعَةَ عَشَرَ", "سَبْعَ عَشْرَةَ", "сабаата ашара / сабаа ашрата"],
  ["18", "١٨", "ثَمَانِيَةَ عَشَرَ", "ثَمَانِيَ عَشْرَةَ", "саманията ашара / самания ашрата"],
  ["19", "١٩", "تِسْعَةَ عَشَرَ", "تِسْعَ عَشْرَةَ", "тисаата ашара / тисаа ашрата"],
] as const;

const tens = [
  ["20", "٢٠", "عِشْرُونَ", "ишруна"],
  ["30", "٣٠", "ثَلَاثُونَ", "салясуна"],
  ["40", "٤٠", "أَرْبَعُونَ", "арбауна"],
  ["50", "٥٠", "خَمْسُونَ", "хамсуна"],
  ["60", "٦٠", "سِتُّونَ", "ситтуна"],
  ["70", "٧٠", "سَبْعُونَ", "сабуна"],
  ["80", "٨٠", "ثَمَانُونَ", "самануна"],
  ["90", "٩٠", "تِسْعُونَ", "тисуна"],
  ["100", "١٠٠", "مِائَةٌ", "миатун"],
] as const;

const agreement = [
  [
    "1–2",
    "Существительное в ед. или двойственном числе; числительное согласуется в роде.",
    "كِتَابٌ وَاحِدٌ (одна книга), كِتَابَانِ (две книги), عَيْنَانِ (два глаза), سَيَّارَتَانِ (две машины)",
  ],
  [
    "3–10",
    "Противоположный род по ед. числу арабского слова + мн. число родительного падежа.",
    "ثَلَاثَةُ كُتُبٍ (три книги — от м.р. كِتَابٌ), خَمْسُ سَيَّارَاتٍ (пять машин — от ж.р. سَيَّارَةٌ)",
  ],
  [
    "11–12",
    "Род обеих частей совпадает с ед. числом арабского слова + ед. число винительного падежа.",
    "اثْنَا عَشَرَ كِتَابًا (12 книг), اثْنَتَا عَشْرَةَ سَيَّارَةً (12 машин)",
  ],
  [
    "13–19",
    "Единицы в противоположном роде, «десять» (عَشَرَ / عَشْرَةَ) — в роде существительного + ед. число винительного падежа.",
    "ثَلَاثَةَ عَشَرَ كِتَابًا (13 книг), ثَلَاثَ عَشْرَةَ سَيَّارَةً (13 машин)",
  ],
  [
    "20–99",
    "Десятки не меняются по роду; существительное в ед. числе винительного падежа.",
    "عِشْرُونَ كِتَابًا (20 книг), خَمْسٌ وَعِشْرُونَ سَيَّارَةً (25 машин)",
  ],
  [
    "100 и 1000",
    "Существительное в ед. числе родительного падежа.",
    "مِائَةُ كِتَابٍ (100 книг), مِائَةُ سَيَّارَةٍ (100 машин)",
  ],
] as const;

const faq = [
  {
    question: "В какую сторону пишутся многозначные числа в арабском тексте?",
    answer: "Слева направо — так же, как в русском языке, даже если вся строка идёт справа налево. Например, 2026 пишется ٢٠٢٦ (сначала двойка слева, затем ноль, два и шесть), а 45 — ٤٥.",
  },
  {
    question: "Почему привычные цифры 0–9 называют арабскими, если в Египте пишут ٠١٢٣?",
    answer: "Обе системы имеют общее индо-арабское происхождение. Знаки 0–9 пришли в Европу через запад арабского мира (Магриб), поэтому их и сегодня используют в Марокко, Алжире и Тунисе. Знаки ٠١٢٣٤٥٦٧٨٩ называют восточноарабскими: они приняты в Египте, Саудовской Аравии, ОАЭ и странах Леванта.",
  },
  {
    question: "Как читаются составные числа вроде 25 или 47?",
    answer: "В арабском сначала называют единицы, затем союз وَ («и»), затем десятки: 25 — خَمْسَةٌ وَعِشْرُونَ («пять и двадцать»), 47 — سَبْعَةٌ وَأَرْبَعُونَ («семь и сорок»).",
  },
  {
    question: "Как определить род числительного от 3 до 10?",
    answer: "Всегда проверяйте род единственного числа самого арабского слова, а не русского перевода. Слово كِتَابٌ («книга») в арабском мужского рода, поэтому «три книги» — ثَلَاثَةُ كُتُبٍ (числительное с та марбутой, противоположного рода).",
  },
  {
    question: "Почему в слове «сто» (مِائَةٌ) пишется буква алиф, но она не читается?",
    answer: "Это историческое написание: алиф в مِائَةٌ когда-то помогал отличать слово без точек от других похожих начертаний. Сегодня он сохраняется на письме (встречается также вариант مِئَةٌ), но произносится коротко — «миатун».",
  },
];
---

<GuideLayout {...seo} guide={guide}>
  <header class="guide-hero">
    <p class="eyebrow">Счёт и грамматика</p>
    <h1 class="page-title">Цифры и числа на арабском от 0 до 100</h1>
    <p class="guide-lead">В арабских странах на ценниках, номерах домов и страницах книг встречаются восточные цифры <span class="arabic-inline" lang="ar" dir="rtl">٠ ١ ٢ ٣ ٤ ٥ ٦ ٧ ٨ ٩</span>. Разбираем, как их читать, в какую сторону записывать многозначные числа и как правильно согласовывать числа с существительными.</p>
    <div class="alphabet-line card" lang="ar" dir="rtl" aria-label="Восточноарабские цифры от нуля до девяти">٠ ١ ٢ ٣ ٤ ٥ ٦ ٧ ٨ ٩</div>
    <div class="guide-answer card"><strong>Коротко:</strong> в арабском тексте слова идут справа налево, а цифры внутри числа — <strong>слева направо</strong> (<span class="arabic-inline" lang="ar" dir="rtl">٤٥</span> — это 45, а не 54). При счёте от 3 до 10 род числительного противоположен роду единственного числа арабского существительного, а с 11 до 99 существительное ставится в единственное число винительного падежа.</div>
    <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
  </header>

  <div class="guide-layout">
    <aside class="guide-toc" aria-label="Содержание статьи">
      <strong>В этой статье</strong>
      <a href="#digits">Восточные и западные цифры</a>
      <a href="#direction">Направление записи чисел</a>
      <a href="#zero-ten">Числа от 0 до 10</a>
      <a href="#teens">Числа от 11 до 19</a>
      <a href="#tens">Десятки 20–90 и 100</a>
      <a href="#agreement">Правила согласования</a>
      <a href="#faq">Частые вопросы</a>
    </aside>

    <article class="guide-content">
      <section id="digits">
        <h2>Восточные и западные цифры: где какие используют</h2>
        <p>В арабском мире параллельно живут два набора знаков: привычные нам <strong>0–9</strong> (западные) и <strong><span class="arabic-inline" lang="ar" dir="rtl">٠–٩</span></strong> (восточноарабские). В Египте, Саудовской Аравии, Иордании и на многих ценниках в ОАЭ часто используют восточные цифры, а в странах Магриба (Марокко, Тунис, Алжир) и в международных меню — западные.</p>
        <div class="guide-note card card-neutral card-warm">
          <strong>На что обратить внимание:</strong> цифра <span class="arabic-inline" lang="ar" dir="rtl">٠</span> (ноль) — это точка, а кружок <span class="arabic-inline" lang="ar" dir="rtl">٥</span> — это <strong>пятёрка</strong>. Цифра <span class="arabic-inline" lang="ar" dir="rtl">٦</span> (шесть) похожа на семёрку, а <span class="arabic-inline" lang="ar" dir="rtl">٧</span> (семь) и <span class="arabic-inline" lang="ar" dir="rtl">٨</span> (восемь) — это «галочки» вверх и вниз.
        </div>
      </section>

      <section id="direction">
        <h2>Направление записи чисел в строке</h2>
        <p>Это правило часто удивляет начинающих: арабское предложение пишется справа налево, но сами многозначные числа внутри него записываются <strong>слева направо</strong> — от старшего разряда к младшему:</p>
        <div class="vowel-row vowel-row-3" aria-label="Примеры записи многозначных чисел" data-appear-group>
          <div class="tile tile-gold"><span lang="ar" dir="rtl">٢٥</span><strong>25</strong><small>два слева, пять справа</small></div>
          <div class="tile tile-gold"><span lang="ar" dir="rtl">١٠٠</span><strong>100</strong><small>единица слева</small></div>
          <div class="tile tile-gold"><span lang="ar" dir="rtl">٢٠٢٦</span><strong>2026</strong><small>как в русском</small></div>
        </div>
        <p>Зато при чтении вслух двузначных чисел сначала называют единицы, а потом десятки через союз <span class="arabic-inline" lang="ar" dir="rtl">وَ</span> («и»): <span class="arabic-inline" lang="ar" dir="rtl">٢٥</span> читается <span class="arabic-inline" lang="ar" dir="rtl">خَمْسَةٌ وَعِشْرُونَ</span> («пять и двадцать»).</p>
      </section>

      <section id="zero-ten">
        <h2>Числа от 0 до 10 с огласовками</h2>
        <p>Запомните сразу обе формы: у чисел 1–2 форма с <span class="arabic-inline" lang="ar" dir="rtl">ة</span> относится к женскому роду, а начиная с 3 включается обратное правило — форма с <span class="arabic-inline" lang="ar" dir="rtl">ة</span> ставится с существительными мужского рода.</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Число</th>
                <th scope="col">Цифра</th>
                <th scope="col">Основная форма</th>
                <th scope="col">Чтение</th>
                <th scope="col">Парная форма</th>
              </tr>
            </thead>
            <tbody>
              {zeroToTen.map(([num, eastern, ar, reading, pair]) => (
                <tr>
                  <th scope="row">{num}</th>
                  <td class="ar" lang="ar" dir="rtl">{eastern}</td>
                  <td class="ar ar-small" lang="ar" dir="rtl">{ar}</td>
                  <td><strong>{reading}</strong></td>
                  <td set:html={richArabic(pair)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="teens">
        <h2>Числа от 11 до 19</h2>
        <p>Числа второго десятка состоят из двух слов, и почти во всех падежах обе части оканчиваются на фатху (кроме первой части числа 12, которая изменяется как двойственное число):</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Число</th>
                <th scope="col">Цифра</th>
                <th scope="col">С существительным м.р.</th>
                <th scope="col">С существительным ж.р.</th>
                <th scope="col">Чтение</th>
              </tr>
            </thead>
            <tbody>
              {elevenToNineteen.map(([num, eastern, masc, fem, reading]) => (
                <tr>
                  <th scope="row">{num}</th>
                  <td class="ar" lang="ar" dir="rtl">{eastern}</td>
                  <td class="ar ar-small" lang="ar" dir="rtl">{masc}</td>
                  <td class="ar ar-small" lang="ar" dir="rtl">{fem}</td>
                  <td><small>{reading}</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="guide-note card card-neutral card-warm">
          <strong>Тренируйте числа на слух и в фразах:</strong> в программе Acrab числа отрабатываются в упражнениях с озвучкой и контекстными примерами — попробуйте бесплатный старт без срока.
          <div class="hero-downloads"><a class="btn btn-compact" href="/get/">Попробовать Acrab бесплатно</a></div>
        </div>
      </section>

      <section id="tens">
        <h2>Десятки от 20 до 90 и 100</h2>
        <p>Десятки образованы от корней соответствующих единиц (кроме «двадцати», родственного слову «десять») и не меняются по роду. В именительном падеже они оканчиваются на <span class="arabic-inline" lang="ar" dir="rtl">ـُونَ</span>, а в родительном и винительном — на <span class="arabic-inline" lang="ar" dir="rtl">ـِينَ</span> (например, <span class="arabic-inline" lang="ar" dir="rtl">عِشْرِينَ</span>).</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Число</th>
                <th scope="col">Цифра</th>
                <th scope="col">По-арабски</th>
                <th scope="col">Чтение</th>
              </tr>
            </thead>
            <tbody>
              {tens.map(([num, eastern, ar, reading]) => (
                <tr>
                  <th scope="row">{num}</th>
                  <td class="ar" lang="ar" dir="rtl">{eastern}</td>
                  <td class="ar ar-small" lang="ar" dir="rtl">{ar}</td>
                  <td><strong>{reading}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="agreement">
        <h2>Правила согласования чисел с существительными</h2>
        <p>В арабском выбор рода числительного и формы существительного зависит от диапазона числа и от рода <strong>единственного числа арабского слова</strong> (а не русского перевода). Например, <span class="arabic-inline" lang="ar" dir="rtl">كِتَابٌ</span> («книга») — мужского рода, а <span class="arabic-inline" lang="ar" dir="rtl">سَيَّارَةٌ</span> («машина») — женского.</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Диапазон</th>
                <th scope="col">Правило</th>
                <th scope="col">Примеры</th>
              </tr>
            </thead>
            <tbody>
              {agreement.map(([range, rule, examples]) => (
                <tr>
                  <th scope="row">{range}</th>
                  <td set:html={richArabic(rule)} />
                  <td set:html={richArabic(examples)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>Если вы готовитесь к поездке и хотите сразу применить числа для цен и покупок, загляните в <a href="/arabic-travel-phrases/">арабский разговорник для ОАЭ и Египта</a>.</p>
        <GuideCta title="Закрепите арабский счёт и грамматику в Acrab" text="Теория по-русски перед упражнениями, полные огласовки, интервальное повторение и ИИ-ассистент — бесплатный старт без срока." />
      </section>

      <GuideFaq items={faq} />
    </article>
  </div>

  <nav class="related-guides" data-appear-group aria-label="Другие статьи">
    <a href="/arabic-travel-phrases/"><span>Числа в поездке</span><strong>Разговорник для ОАЭ и Египта →</strong></a>
    <a href="/arabic-vowels/"><span>Знаки чтения</span><strong>Огласовки в арабском →</strong></a>
    <a href="/learn-arabic/"><span>Полный маршрут</span><strong>Как выучить арабский с нуля →</strong></a>
  </nav>
</GuideLayout>
