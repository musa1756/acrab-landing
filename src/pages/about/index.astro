---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import Release from "../../components/Release.astro";

const releases = (await getCollection("changelog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout section="updates" title="Обновления Acrab: что нового в приложении для арабского" description="История версий Acrab, приложения для изучения литературного арабского на русском: книги в Библиотеке, друзья, Анки, новые уроки и исправления." canonical="https://acrab.ru/about/" ogTitle="Обновления Acrab" ogDescription="Что изменилось в каждой версии Acrab: новинки, улучшения и исправления." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg">
    <div class="page-head page-head-centered">
      <div class="page-head-inner">
        <p class="eyebrow">Обновления</p>
        <h1 class="page-title">Что нового в Acrab</h1>
        <p class="page-lead">Что изменилось в каждой версии приложения: главная новинка, улучшения и исправления.</p>
      </div>
    </div>
    <div class="changelog">
      {releases.map((release, index) => <Release release={release} open={index === 0} />)}
      <p class="changelog-note" data-appear>Здесь собраны версии начиная с 2.2. Те же заметки есть в приложении: кнопка с искрами рядом с заголовком «Программа».</p>
    </div>
  <noscript><style>.release-collapse { grid-template-rows: 1fr; opacity: 1; visibility: visible; }</style></noscript>
  <script>
    // Карточка версии раскрывается по нажатию на заголовок; #v2-4 в адресе раскрывает свою.
    const cards = document.querySelectorAll<HTMLElement>(".release");
    const setOpen = (card: HTMLElement, open: boolean) => {
      card.classList.toggle("is-open", open);
      card.querySelector(".release-toggle")?.setAttribute("aria-expanded", String(open));
    };
    cards.forEach((card) => {
      card.querySelector(".release-toggle")?.addEventListener("click", () => setOpen(card, !card.classList.contains("is-open")));
    });
    const openFromHash = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (target?.classList.contains("release")) setOpen(target, true);
    };
    openFromHash();
    addEventListener("hashchange", openFromHash);
  </script>
</PageLayout>
