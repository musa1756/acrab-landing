---
import PageLayout from "../layouts/PageLayout.astro";
import Icon from "../components/Icon.astro";
import StoreLinks from "../components/StoreLinks.astro";
import SocialTrust from "../components/home/SocialTrust.astro";
import LearningPath from "../components/home/LearningPath.astro";
import { appSchema, organizationSchema, websiteSchema } from "../seo/schema";
import "../styles/page-home.css";

// Слова вокруг заголовка: нажатие играет озвучку из приложения (те же файлы,
// что в статьях о приветствиях и благодарности). Места и наклон плашек — в
// home-hero.css по порядку: CSP сайта не пускает атрибут style.
const HERO_WORDS = [
  { ar: "مَرْحَبًا", reading: "мархабан", ru: "привет", audio: "/assets/audio/marhaban.mp3" },
  { ar: "كَيْفَ حَالُكَ؟", reading: "кайфа халюка", ru: "как дела?", audio: "/assets/audio/kayfa-haluka.mp3" },
  { ar: "شُكْرًا", reading: "шукран", ru: "спасибо", audio: "/assets/audio/shukran.mp3" },
  { ar: "أَهْلًا وَسَهْلًا", reading: "ахлян ва сахлян", ru: "добро пожаловать", audio: "/assets/audio/ahlan-wa-sahlan.mp3" },
  { ar: "صَبَاحُ الْخَيْرِ", reading: "сабаху-ль-хайр", ru: "доброе утро", audio: "/assets/audio/sabah-al-khayr.mp3" },
  { ar: "السَّلَامُ عَلَيْكُمْ", reading: "ас-саляму алайкум", ru: "мир вам", audio: "/assets/audio/as-salamu-alaykum.mp3" },
];
---

<PageLayout section="home" title="Арабский язык с нуля — приложение для изучения | Acrab" description="Литературный арабский с нуля в приложении Acrab: 81 модуль от алфавита до грамматики, правила по-русски, огласовки, аудирование, повторение и 9 инструментов." canonical="https://acrab.ru/" robots="index, follow, max-image-preview:large" ogTitle="Арабский язык с нуля — Acrab" ogDescription="Программа фусхи из 81 модуля, правила по-русски, огласовки, повторение и инструменты в одном приложении." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg" ogImageAlt="Иконка приложения Acrab для изучения арабского языка" twitterCard="summary" jsonLd={[organizationSchema, websiteSchema, appSchema]} floatingHeader>
<!-- ═══ Первый экран: фраза и три магазина ═════════════════════════════ -->
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero-copy">
    <div class="hero-words">
      {HERO_WORDS.map((w) => (
        <span class="hero-word-slot">
          <button type="button" class="hero-word" data-audio={w.audio} aria-label={`Слушать: ${w.reading}, «${w.ru}»`} hidden>
            <Icon name="speaker-high" />
            <span class="hero-word-text"><span class="hero-word-ar" lang="ar" dir="rtl">{w.ar}</span><small>{w.ru}</small></span>
          </button>
        </span>
      ))}
    </div>
    <h1 class="home-hero-title" id="home-title">Арабский язык<br><span>ближе, чем кажется</span></h1>
    <p class="home-hero-lead">От 28 букв до разговора и чтения книг. Самые нужные инструменты — в одном месте.</p>
    <StoreLinks class="home-hero-stores" centered />
    <p class="home-hero-note">Для iPhone, iPad и Android</p>
  </div>
</section>
<script src="../scripts/phrase-audio.ts"></script>

<!-- ═══ Второй экран: оценки, отзывы, урок вдвоём и призыв ═══════════════ -->
<SocialTrust />

<!-- ═══ Третий экран: путь от букв до книг на скринах приложения ════════ -->
<LearningPath />
</PageLayout>
