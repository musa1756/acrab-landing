---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { appSchema, organizationSchema, websiteSchema } from "../seo/schema";
import { GUIDES } from "../seo/guides";
---

<BaseLayout title="Арабский язык с нуля — приложение для изучения | Acrab" description="Литературный арабский с нуля в приложении Acrab: 44 модуля от алфавита до грамматики, правила по-русски, огласовки, аудирование, повторение и 9 инструментов." canonical="https://acrab.ru/" robots="index, follow, max-image-preview:large" ogTitle="Арабский язык с нуля — Acrab" ogDescription="Программа фусхи из 44 модулей, правила по-русски, огласовки, повторение и инструменты в одном приложении." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg" ogImageAlt="Иконка приложения Acrab для изучения арабского языка" twitterCard="summary" jsonLd={[organizationSchema, websiteSchema, appSchema]}>
  <a class="skip-link" href="#main">К содержанию</a>
  <Header active="home" />
  <main id="main">
<div class="about">

      <!-- ═══ Герой ═══════════════════════════════════════════════════════ -->
      <section class="about-hero">
        <div class="about-hero-copy">
          <p class="eyebrow">Арабский язык с нуля</p>
          <h1 class="page-title">Учите литературный арабский по шагам</h1>
          <p class="about-hero-lead">Acrab ведёт от 28 букв до чтения текстов с огласовками. Правила объяснены по-русски, а перевод, спряжение и ИИ-учитель открываются в соседних вкладках того же приложения.</p>
          <div class="about-hero-actions store-links" aria-label="Скачать Acrab">
            <a class="store-link" href="https://apps.apple.com/ru/app/acrab-%D0%B0%D1%80%D0%B0%D0%B1%D1%81%D0%BA%D0%B8%D0%B9-%D1%8F%D0%B7%D1%8B%D0%BA/id6763663680" target="_blank" rel="noopener" aria-label="Скачать Acrab в App Store">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.05 12.53c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.71-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.75 2.21 1.1-.05 1.52-.72 2.85-.72 1.33 0 1.71.72 2.88.69 1.19-.02 1.94-1.08 2.67-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.54zM14.87 6.09c.61-.74 1.02-1.77.91-2.79-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.7-.92 2.7.98.08 1.98-.5 2.58-1.23z"/></svg>
              <span class="store-link-text"><span class="store-link-kicker">Загрузите в</span><span class="store-link-name">App Store</span></span>
            </a>
            <a class="store-link" href="https://www.rustore.ru/catalog/app/com.acrab" target="_blank" rel="noopener" aria-label="Скачать Acrab в RuStore">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.6 9.48l1.84-3.18a.38.38 0 0 0-.14-.52.38.38 0 0 0-.52.14l-1.87 3.23a11.43 11.43 0 0 0-9.82 0L5.22 5.92a.38.38 0 0 0-.52-.14.38.38 0 0 0-.14.52L6.4 9.48A10.81 10.81 0 0 0 1 18h22a10.81 10.81 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>
              <span class="store-link-text"><span class="store-link-kicker">Доступно в</span><span class="store-link-name">RuStore</span></span>
            </a>
            <a class="store-link" href="https://play.google.com/store/apps/details?id=com.acrab.arabic" target="_blank" rel="noopener" aria-label="Скачать Acrab в Google Play">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/></svg>
              <span class="store-link-text"><span class="store-link-kicker">Доступно в</span><span class="store-link-name">Google Play</span></span>
            </a>
          </div>
          <dl class="about-stats">
            <div class="about-stat"><dd>44</dd><dt>модуля в программе</dt></div>
            <div class="about-stat"><dd>6</dd><dt>модулей бесплатно и без срока</dt></div>
            <div class="about-stat"><dd>9</dd><dt>инструментов для слов и текстов</dt></div>
            <div class="about-stat"><dd>3</dd><dt>платформы: iPhone, iPad, Android</dt></div>
          </dl>
        </div>
        <div class="shot about-hero-figure">
          <img src="/assets/about/program-path.webp" alt="Экран «Программа»: модули с названиями, описанием и процентом прохождения" width="620" height="1250" fetchpriority="high">
        </div>
      </section>

      <!-- ═══ Карта разделов: те же пять вкладок, что в приложении ═══════════
           Плитки-ссылки .tile-neutral, значки — вкладки AppTabs.tsx. -->
      <nav class="about-map" aria-label="Разделы приложения" data-appear-group>
        <a class="tile tile-neutral" href="#program">
          <span class="icon-badge"><Icon name="graduation-cap" /></span>
          <span class="about-map-name">Программа</span>
          <span class="about-map-sub">44 модуля и тренировки</span>
        </a>
        <a class="tile tile-neutral" href="#tools">
          <span class="icon-badge"><Icon name="sparkle" /></span>
          <span class="about-map-name">Инструменты</span>
          <span class="about-map-sub">Перевод, спряжение, Анки</span>
        </a>
        <a class="tile tile-neutral" href="#assistant">
          <span class="icon-badge"><Icon name="chats-circle" /></span>
          <span class="about-map-name">Ассистент</span>
          <span class="about-map-sub">ИИ-учитель на русском</span>
        </a>
        <a class="tile tile-neutral" href="#library">
          <span class="icon-badge"><Icon name="books" /></span>
          <span class="about-map-name">Библиотека</span>
          <span class="about-map-sub">Книги, картинки, глаголы</span>
        </a>
        <a class="tile tile-neutral" href="#streak">
          <span class="icon-badge"><Icon name="user-circle" /></span>
          <span class="about-map-name">Профиль</span>
          <span class="about-map-sub">Серия, друзья, синхронизация</span>
        </a>
      </nav>

      <!-- ═══ Программа ════════════════════════════════════════════════ -->
      <section class="about-section" id="program" aria-labelledby="program-title">
        <div class="about-section-head" data-appear>
          <h2 class="about-h" id="program-title">44 модуля: от первой буквы до грамматики</h2>
          <p class="about-p">Модули идут по порядку, и каждый опирается на предыдущий. Сначала 28 букв и чтение, потом приветствия, рассказ о себе, артикль <span lang="ar">ال</span> с солнечными и лунными буквами, именное предложение и дальше грамматика. Модули собраны в четыре курса: от «Алиф: первые шаги» до «Мир: говорим шире».</p>
          <ul class="about-points about-points-spaced">
            <li><Icon name="check-circle" class="about-check" /><strong>Видно, куда вы идёте.</strong> У каждого модуля есть название, цель на практике и процент прохождения.</li>
            <li><Icon name="check-circle" class="about-check" /><strong>Тест уровня при первом запуске.</strong> Если вы уже учили арабский, ответьте на 10–12 вопросов, и приложение подскажет, с какого модуля начать.</li>
            <li><Icon name="check-circle" class="about-check" /><strong>Урок тренирует только свою лексику.</strong> Слова из следующих модулей в него не попадают.</li>
            <li><Icon name="check-circle" class="about-check" /><strong>Огласовки во всех модулях:</strong> в словах, примерах и упражнениях.</li>
            <li><Icon name="check-circle" class="about-check" /><strong>Уроки работают без интернета.</strong> Тексты и озвучка уроков хранятся на устройстве.</li>
          </ul>
        </div>

        <h3 class="about-subhead" data-appear>Как устроен урок</h3>
        <div class="about-cards" data-appear-group>
          <article class="card card-plain about-card">
            <figure class="about-card-shot"><img src="/assets/about/lesson-theory.webp" alt="Карточка «Теория» в уроке: правило про настоящее время с примерами" width="620" height="1212" loading="lazy"></figure>
            <div class="about-card-body">
              <h3>Сначала правило</h3>
              <p>Новая тема начинается с короткой теории по-русски: как строится форма и где она встречается. Все примеры с огласовками.</p>
            </div>
          </article>
          <article class="card card-plain about-card">
            <figure class="about-card-shot"><img src="/assets/about/lesson-choice.webp" alt="Упражнение «Выберите перевод»: арабское слово и четыре варианта ответа" width="620" height="896" loading="lazy"></figure>
            <div class="about-card-body">
              <h3>Выбор перевода</h3>
              <p>Слово с огласовками и озвучкой и четыре варианта. Ответ проверяется сразу, верный приносит XP.</p>
            </div>
          </article>
          <article class="card card-plain about-card">
            <figure class="about-card-shot"><img src="/assets/about/lesson-build.webp" alt="Упражнение «Соберите предложение»: арабские слова собираются в строку" width="576" height="1168" loading="lazy"></figure>
            <div class="about-card-body">
              <h3>Соберите предложение</h3>
              <p>Русская фраза и арабские слова вразброс: расставьте их по порядку. Засчитываются разные верные варианты перевода.</p>
            </div>
          </article>
          <article class="card card-plain about-card">
            <figure class="about-card-shot"><img src="/assets/about/lesson-listening.webp" alt="Упражнение «Аудирование»: волна звука и четыре варианта перевода" width="576" height="1128" loading="lazy"></figure>
            <div class="about-card-body">
              <h3>Аудирование</h3>
              <p>Фраза звучит без текста. Её можно замедлить, повторить или показать написание, а потом выбрать перевод.</p>
            </div>
          </article>
        </div>
      </section>

      <!-- ═══ Быстрые тренировки ═══════════════════════════════════════
           Названия и подписи карточек — из mobile/src/features/fusha/training. -->
      <section class="about-section" id="drills" aria-labelledby="drills-title">
        <div class="about-section-head" data-appear>
          <h2 class="about-h" id="drills-title">Слово возвращается, пока не закрепится</h2>
          <p class="about-p">На главном экране «Программы» есть блок «Быстрые тренировки». Он берёт слова и фразы из пройденных уроков и возвращает их через 1, 7 и 30 дней. После третьего верного ответа в срок слово считается закреплённым.</p>
        </div>

        <div class="drill-grid" data-appear-group>
          <div class="drill drill-review">
            <div class="drill-top">
              <span class="drill-icon" aria-hidden="true"><Icon name="arrow-clockwise" /></span>
              <span class="drill-count">10</span>
            </div>
            <div class="drill-copy">
              <p class="drill-name">Повторить</p>
              <p class="drill-note">То, что пора освежить. Порция дня — 10 заданий.</p>
            </div>
          </div>
          <div class="drill drill-speed">
            <div class="drill-top">
              <span class="drill-icon" aria-hidden="true"><Icon name="lightning" /></span>
              <span class="drill-count">90 с</span>
            </div>
            <div class="drill-copy">
              <p class="drill-name">Скорость</p>
              <p class="drill-note">Знакомые слова на время: до 20 заданий за 90 секунд.</p>
            </div>
          </div>
          <div class="drill drill-hard">
            <div class="drill-top">
              <span class="drill-icon" aria-hidden="true"><Icon name="warning" /></span>
              <span class="drill-count">2</span>
            </div>
            <div class="drill-copy">
              <p class="drill-name">Разобрать ошибки</p>
              <p class="drill-note">Слова, в которых вы ошиблись. Один верный ответ закрывает ошибку.</p>
            </div>
          </div>
          <div class="drill drill-listen">
            <div class="drill-top">
              <span class="drill-icon" aria-hidden="true"><Icon name="ear" /></span>
              <span class="drill-count">8</span>
            </div>
            <div class="drill-copy">
              <p class="drill-name">Аудирование</p>
              <p class="drill-note">Только на слух, без текста на экране.</p>
            </div>
          </div>
        </div>
        <div class="drill-words" data-appear>
          <span class="drill-words-icon" aria-hidden="true"><Icon name="book-open" /></span>
          <p class="about-p">Под тренировками — «Мои слова»: темы, слова из уроков и ваши собственные. Тему можно пройти тестом или повторять карточками в инструменте «Анки».</p>
        </div>
      </section>

      <!-- ═══ Инструменты ══════════════════════════════════════════════
           Плитки повторяют TOOL_FEATURES из mobile/src/features/tools/ToolsScreen.tsx:
           тот же порядок, названия и подписи, цвета — из toolAccent. -->
      <section class="about-section" id="tools" aria-labelledby="tools-title">
        <div class="about-section-head" data-appear>
          <h2 class="about-h" id="tools-title">Девять инструментов вместо вкладок в браузере</h2>
          <p class="about-p">Всё, ради чего обычно уходят из урока в поиск: перевести фразу, расставить огласовки, проспрягать глагол, найти родственные слова, услышать произношение. Спряжение, Семья слов и Анки работают без интернета.</p>
        </div>

        <div class="tool-groups">
          <div class="tool-group">
            <h3 class="tool-group-title t-headline">Работа с текстом</h3>
            <div class="tool-grid" data-appear-group>
              <div class="tool tool-translate">
                <div class="tool-top">
                  <Icon name="translate-bold" />
                  <span class="tool-ar" lang="ar">تَرْجَمَةٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Перевод</p>
                  <p class="tool-sub">Арабский ⇄ Русский</p>
                </div>
              </div>
              <div class="tool tool-harakat">
                <div class="tool-top">
                  <Icon name="text-aa-bold" />
                  <span class="tool-ar" lang="ar">تَشْكِيلٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Огласовки</p>
                  <p class="tool-sub">Текст или фото → огласовки</p>
                </div>
              </div>
              <div class="tool tool-voice">
                <div class="tool-top">
                  <Icon name="file-audio-bold" />
                  <span class="tool-ar" lang="ar">صَوْتٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Озвучка</p>
                  <p class="tool-sub">Фраза → аудио и перевод</p>
                </div>
              </div>
            </div>
          </div>
          <div class="tool-group">
            <h3 class="tool-group-title t-headline">Изучение слов</h3>
            <div class="tool-grid" data-appear-group>
              <div class="tool tool-vocab">
                <div class="tool-top">
                  <Icon name="book-bookmark-bold" />
                  <span class="tool-ar" lang="ar">مُفْرَدَاتٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Слова по теме</p>
                  <p class="tool-sub">12 слов по теме</p>
                </div>
              </div>
              <div class="tool tool-examples">
                <div class="tool-top">
                  <Icon name="article-ny-times-bold" />
                  <span class="tool-ar" lang="ar">أَمْثِلَةٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Примеры</p>
                  <p class="tool-sub">Контекст и озвучка</p>
                </div>
              </div>
              <div class="tool tool-image">
                <div class="tool-top">
                  <Icon name="panorama-bold" />
                  <span class="tool-ar" lang="ar">صُورَةٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Картинка</p>
                  <p class="tool-sub">Образ слова и подпись</p>
                </div>
              </div>
              <div class="tool tool-anki">
                <div class="tool-top">
                  <Icon name="stack-bold" />
                  <span class="tool-ar" lang="ar">مُرَاجَعَةٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Анки</p>
                  <p class="tool-sub">Повторение слов по темам</p>
                </div>
              </div>
            </div>
          </div>
          <div class="tool-group">
            <h3 class="tool-group-title t-headline">Грамматика</h3>
            <div class="tool-grid" data-appear-group>
              <div class="tool tool-conj">
                <div class="tool-top">
                  <Icon name="table-bold" />
                  <span class="tool-ar" lang="ar">تَصْرِيفٌ</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Спряжение</p>
                  <p class="tool-sub">Таблица глагольных форм</p>
                </div>
              </div>
              <div class="tool tool-root">
                <div class="tool-top">
                  <Icon name="git-merge-bold" />
                  <span class="tool-ar" lang="ar">عَائِلَة</span>
                </div>
                <div class="tool-copy">
                  <p class="tool-name">Семья слов</p>
                  <p class="tool-sub">Корень и родственные слова</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="shot-row" data-appear tabindex="0" role="group" aria-label="Экраны инструментов, прокручиваются по горизонтали">
          <figure>
            <div class="shot shot-crop"><img src="/assets/about/tool-translate.webp" alt="Переводчик: русская фраза и её арабский перевод с огласовками" width="620" height="988" loading="lazy"></div>
            <figcaption><strong>Перевод</strong>Язык определяется сам. Перевод приходит с огласовками, а каждое слово можно нажать и узнать, что оно значит в этой фразе.</figcaption>
          </figure>
          <figure>
            <div class="shot shot-crop"><img src="/assets/about/tool-conjugation.webp" alt="Спряжение глагола قرأ в настоящем времени, 14 форм" width="620" height="1196" loading="lazy"></div>
            <figcaption><strong>Спряжение</strong>Больше 1 200 глаголов. В прошедшем и настоящем времени по 14 форм, в повелительном наклонении и запрете по 6.</figcaption>
          </figure>
          <figure>
            <div class="shot shot-crop"><img src="/assets/about/tool-root.webp" alt="Семья слов: корень ك-ت-ب и производные — глагол, масдар, деятель, объект" width="620" height="1196" loading="lazy"></div>
            <figcaption><strong>Семья слов</strong>Корень <span lang="ar">ك‑ت‑ب</span> и слова от него: глаголы пород I–X, масдар, имена деятеля и объекта. В базе 955 корней.</figcaption>
          </figure>
          <figure>
            <div class="shot shot-crop"><img src="/assets/about/tool-tts.webp" alt="Озвучка: фраза, волна звука и пословная подсветка" width="620" height="1212" loading="lazy"></div>
            <figcaption><strong>Озвучка</strong>Фраза до 65 символов превращается в аудио с переводом. Её можно замедлить и повторить, а звучащее слово подсвечивается.</figcaption>
          </figure>
          <figure>
            <div class="shot shot-crop"><img src="/assets/about/tool-examples.webp" alt="Примеры: слово «пчела» в разных ситуациях с переводом и озвучкой" width="620" height="1212" loading="lazy"></div>
            <figcaption><strong>Примеры</strong>Пять фраз со словом в разных ситуациях: «в саду», «урок биологии», «прогулка». У каждой есть перевод и озвучка.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ═══ Ассистент ════════════════════════════════════════════════ -->
      <section class="about-section" id="assistant" aria-labelledby="assistant-title">
        <div class="about-showcase about-showcase-tall about-showcase-integrated">
