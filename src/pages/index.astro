---
import PageLayout from "../layouts/PageLayout.astro";
import Icon from "../components/Icon.astro";
import StoreLinks from "../components/StoreLinks.astro";
import Sheet from "../components/home/Sheet.astro";
import Statement from "../components/home/Statement.astro";
import Feature from "../components/home/Feature.astro";
import ToolCards from "../components/home/ToolCards.astro";
import StoreMarquee from "../components/home/StoreMarquee.astro";
import StackCards from "../components/home/StackCards.astro";
import ReviewCards from "../components/home/ReviewCards.astro";
import PairDemo from "../components/home/PairDemo.astro";
import FreeVsFull from "../components/home/FreeVsFull.astro";
import HomeFaq from "../components/home/HomeFaq.astro";
import { HOME_FAQ } from "../data/app-faq";
import { appSchema, organizationSchema, websiteSchema } from "../seo/schema";
import "../styles/page-home.css";

// Слова вокруг заголовка: нажатие играет озвучку из приложения (те же файлы,
// что в статьях о приветствиях и благодарности). Места и наклон плашек — в
// home-hero.css по порядку: CSP сайта не пускает атрибут style.
const HERO_WORDS = [
  { ar: "مَرْحَبًا", reading: "мархабан", ru: "привет", audio: "/assets/audio/marhaban.mp3" },
  { ar: "كَيْفَ حَالُكَ؟", reading: "кайфа халюка", ru: "как дела?", audio: "/assets/audio/kayfa-haluka.mp3" },
  { ar: "شُكْرًا", reading: "шукран", ru: "спасибо", audio: "/assets/audio/shukran.mp3" },
  { ar: "أَهْلًا وَسَهْلًا", reading: "ахлян ва сахлян", ru: "добро пожаловать", audio: "/assets/audio/ahlan-wa-sahlan.mp3" },
  { ar: "صَبَاحُ الْخَيْرِ", reading: "сабаху-ль-хайр", ru: "доброе утро", audio: "/assets/audio/sabah-al-khayr.mp3" },
  { ar: "السَّلَامُ عَلَيْكُمْ", reading: "ас-саляму алайкум", ru: "мир вам", audio: "/assets/audio/as-salamu-alaykum.mp3" },
];
---

<PageLayout section="home" title="Арабский язык с нуля — приложение для изучения | Acrab" description="Литературный арабский с нуля в приложении Acrab: 81 модуль от алфавита до грамматики, правила по-русски, огласовки, аудирование, повторение и 9 инструментов." canonical="https://acrab.ru/" robots="index, follow, max-image-preview:large" ogTitle="Арабский язык с нуля — Acrab" ogDescription="Программа фусхи из 81 модуля, правила по-русски, огласовки, повторение и инструменты в одном приложении." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg" ogImageAlt="Иконка приложения Acrab для изучения арабского языка" twitterCard="summary" jsonLd={[organizationSchema, websiteSchema, appSchema]} floatingHeader>
<!-- ═══ Первый экран: фраза и три магазина ═════════════════════════════ -->
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero-copy">
    <div class="hero-words">
      {HERO_WORDS.map((w) => (
        <span class="hero-word-slot">
          <button type="button" class="hero-word" data-audio={w.audio} aria-label={`Слушать: ${w.reading}, «${w.ru}»`} hidden>
            <Icon name="speaker-high" />
            <span class="hero-word-text"><span class="hero-word-ar" lang="ar" dir="rtl">{w.ar}</span><small>{w.ru}</small></span>
          </button>
        </span>
      ))}
    </div>
    <h1 class="home-hero-title" id="home-title">Арабский язык<br><span>ближе, чем кажется</span></h1>
    <p class="home-hero-lead">От 28 букв до разговора и чтения книг. Самые нужные инструменты — в одном месте.</p>
    <StoreLinks class="home-hero-stores" centered />
    <p class="home-hero-note">Для iPhone, iPad и Android</p>
  </div>
</section>
<script src="../scripts/phrase-audio.ts"></script>

<!-- ═══ Лист 1: фраза и четыре ряда о занятиях ═══════════════════════ -->
<Sheet labelledby="st-path">
  <Statement id="st-path" kicker="Acrab" text="Арабский язык в одном приложении: от первых букв до чтения книг" />
  <Feature
    id="ft-path"
    tone="gold"
    title="Программа по шагам"
    text="81 модуль идут по порядку: каждый урок опирается на прошлый, и всегда видно, что учить дальше. Начинаете с алфавита, заканчиваете чтением."
    link={{ href: "/learn-arabic/", label: "Как учить арабский с нуля" }}
    shot={{ src: "/assets/about/program-path.webp", width: 620, height: 1250, alt: "Экран «Программа»: модули по порядку с процентом прохождения" }}
  />
  <Feature
    id="ft-lesson"
    flip
    tone="purple"
    title="Правило, потом практика"
    text="Короткая теория по-русски с огласовками, затем задания: собирайте фразы из плиток, выбирайте перевод, слушайте озвучку."
    link={{ href: "/fusha/", label: "Что такое фусха" }}
    shot={{ src: "/assets/about/lesson-build.webp", width: 576, height: 1168, alt: "Задание «Соберите предложение»: фраза «Погода сегодня холодная» из арабских плиток" }}
  />
  <Feature
    id="ft-friends"
    tone="blue"
    title="Учитесь с друзьями"
    text="Проходите урок вдвоём: вы оба выбираете ответ, выбор друга виден сразу, и ответ засчитывается, когда вы сошлись. Друзей можно найти по ID."
    link={{ href: "/arabic-app/", label: "Всё о приложении" }}
  >
    <div class="ft-pair" slot="visual"><PairDemo /></div>
  </Feature>
  <Feature
    id="ft-review"
    flip
    tone="pink"
    title="Слова не забываются"
    text="Интервальное повторение возвращает выученное вовремя. Анки по вашим темам и быстрые тренировки помогают не терять ритм."
    link={{ href: "/arabic-app/", label: "Как устроено повторение" }}
    shot={{ src: "/assets/about/tool-anki.webp", width: 620, height: 1252, alt: "Анки: карточка с глаголом и кнопки «Знаю» и «Не знаю»" }}
  />
</Sheet>

<!-- ═══ Лист 2: девять инструментов лентой ════════════════════════════ -->
<Sheet labelledby="st-tools">
  <Statement id="st-tools" kicker="Инструменты" text="Девять инструментов рядом с уроком, чтобы не искать их в других программах" />
  <ToolCards />
</Sheet>

<StoreMarquee />

<!-- ═══ Лист 3: ассистент, книги, бесплатный старт стопкой ════════════ -->
<Sheet labelledby="st-more">
  <Statement id="st-more" kicker="Для людей" text="Арабский для тех, кто хочет понимать, а не только заучивать" />
  <StackCards />
</Sheet>

<!-- ═══ Лист 4: отзывы ════════════════════════════════════════════════ -->
<Sheet labelledby="st-voices">
  <Statement id="st-voices" kicker="Отзывы" text="Не верите? Послушайте тех, кто уже учит" />
  <ReviewCards />
</Sheet>

<!-- ═══ Лист 5: бесплатно и вопросы ═══════════════════════════════════ -->
<Sheet id="free" labelledby="fv-title">
  <FreeVsFull />
  <HomeFaq items={HOME_FAQ} />
</Sheet>

<section class="fin" aria-labelledby="fin-title">
  <h2 class="fin-title" id="fin-title">Начните с первого урока</h2>
  <p class="fin-text">Скачайте Acrab бесплатно и позовите друга.</p>
  <StoreLinks class="fin-stores" centered />
</section>
<script src="../scripts/statement.ts"></script>
</PageLayout>
