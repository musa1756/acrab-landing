---
import { APP_FAQ } from "../../data/app-faq";
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import StoreLinks from "../../components/StoreLinks.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Приложение для изучения арабского языка с нуля | Acrab",
  "description": "Как выбрать приложение для изучения арабского: программа по порядку, правила по-русски, огласовки, аудирование и повторение. Что умеет Acrab.",
  "ogTitle": "Приложение для изучения арабского языка — Acrab",
  "ogDescription": "Фусха по шагам, правила по-русски, огласовки, аудирование, повторение и девять инструментов.",
  "ogImage": "https://acrab.ru/assets/about/program-path.webp",
  "ogImageAlt": "Экран «Программа» в приложении Acrab для изучения арабского языка"
} as const;

const guide: GuideMeta = {
  headline: "Приложение для изучения арабского языка с нуля",
  description: seo.description,
  path: "/arabic-app/",
  image: seo.ogImage,
  datePublished: "2026-08-08",
  dateModified: "2026-10-01",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Приложение для арабского", path: "/arabic-app/" },
  ],
};

const faq = APP_FAQ;
---

<GuideLayout {...seo} guide={guide}>
    <header class="guide-hero guide-hero-with-media product-guide-hero">
      <div>
        <p class="eyebrow">Acrab для iPhone, iPad и Android</p>
        <h1 class="page-title">Приложение для изучения арабского языка с нуля</h1>
        <p class="guide-lead">Acrab учит литературному арабскому на русском языке: от алфавита до чтения текстов с огласовками. Теория, упражнения, аудирование, повторение и инструменты собраны в одном приложении.</p>
        <div class="hero-downloads"><StoreLinks /></div>
        <p class="hero-fineprint">Первые 4 из 81 модуля бесплатны и без срока.</p>
        <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
      </div>
      <figure class="shot guide-hero-shot"><img src="/assets/about/program-path.webp" alt="Экран «Программа»: модули с названиями, описанием и процентом прохождения" width="620" height="1250" fetchpriority="high"></figure>
    </header>

    <div class="guide-layout">
      <aside class="guide-toc" aria-label="Содержание статьи"><strong>На этой странице</strong><a href="#criteria">Как выбрать приложение</a><a href="#program">Программа Acrab</a><a href="#practice">Как проходит урок</a><a href="#tools">Инструменты</a><a href="#library">Книги</a><a href="#free">Что бесплатно</a><a href="#faq">Частые вопросы</a></aside>
      <article class="guide-content">
        <section id="criteria">
          <h2>На что смотреть при выборе приложения</h2>
          <p>Число карточек и яркий интерфейс не говорят о том, чему вы научитесь. Проверьте пять вещей:</p>
          <ul class="guide-checklist"><li><strong>Есть ли программа по порядку.</strong> Следующий урок должен опираться на предыдущий.</li><li><strong>Объясняют ли грамматику.</strong> Правило нужно понять до того, как вас проверят.</li><li><strong>Показаны ли огласовки.</strong> Начинающему нужно видеть, как точно читается новое слово.</li><li><strong>Есть ли работа на слух.</strong> Узнавать слово глазами на карточке ещё не значит понимать его в речи.</li><li><strong>Возвращаются ли забытые слова.</strong> Повторение должно учитывать ошибки и время, а не листать один и тот же список.</li></ul>
        </section>

        <section id="program">
          <h2>Маршрут из 81 модуля</h2>
          <p>Acrab начинает с 28 букв и их соединения, затем переходит к приветствиям, рассказу о себе, артиклю <span class="arabic-inline" lang="ar" dir="rtl">ال</span>, именным предложениям и дальше к грамматике. Если вы уже учили арабский, при первом запуске пройдите тест уровня из 10–12 вопросов: он подскажет, с какого модуля начать. Урок тренирует только свою лексику: слова из следующих модулей в него не попадают.</p>
        </section>

        <section id="practice">
          <h2>Как проходит занятие</h2>
          <div class="lesson-flow card card-plain" data-appear><div><span>1</span><strong>Понять</strong><p>Короткая теория по-русски объясняет новое правило на примерах с огласовками.</p></div><div><span>2</span><strong>Применить</strong><p>Выбор перевода, сборка предложения, пары слов и другие упражнения проверяют один навык за раз.</p></div><div><span>3</span><strong>Услышать</strong><p>Фразы звучат без текста; их можно замедлить или показать написание.</p></div><div><span>4</span><strong>Повторить вовремя</strong><p>Быстрые тренировки возвращают слова через 1, 7 и 30 дней и разбирают ошибки.</p></div></div>
        </section>

        <section id="tools">
          <h2>Инструменты рядом с уроком</h2>
          <p>Когда встречается непонятная форма, не нужно открывать пять вкладок в браузере. В Acrab девять инструментов: перевод, огласовки, озвучка, слова по теме, примеры, картинки, Анки для повторения слов карточками, спряжение глаголов и семья слов по корню. В соседней вкладке — ИИ-ассистент, который объясняет грамматику по-русски.</p>
          <div class="proof-pair"><figure class="shot"><img src="/assets/about/tool-conjugation.webp" alt="Таблица спряжения арабского глагола в Acrab" width="620" height="1078" loading="lazy"></figure><figure class="shot"><img src="/assets/about/assistant-2026-10.webp" alt="ИИ-ассистент Acrab объясняет арабскую грамматику по-русски" width="620" height="1276" loading="lazy"></figure></div>
        </section>

        <section id="library">
          <h2>Книги для первого чтения</h2>
          <p>В Библиотеке приложения есть «аль-Кироату ар-Рашида»: нажмите на слово, и появится его перевод в этом месте текста. Рядом лежат учебники «Байна ядайк» и «Арабский в рифмах» в PDF, их можно скачать и читать без интернета.</p>
        </section>

        <section id="free">
          <h2>Что можно попробовать бесплатно</h2>
          <p>Бесплатная версия не ограничена по времени. В ней первые четыре модуля с упражнениями и озвучкой, быстрые тренировки, Анки, серия и синхронизация между устройствами. Инструменты и ассистент работают с дневными лимитами: например, ассистенту можно задать 10 вопросов в день.</p>
          <GuideCta title="Начните с подходящего уровня" text="Уже читаете по-арабски — пройдите тест уровня при первом запуске. Если нет, начните с первой буквы." />
        </section>

        <GuideFaq items={faq} />
      </article>
    </div>

    <nav class="related-guides" data-appear-group aria-label="Другие статьи"><a href="/learn-arabic/"><span>План обучения</span><strong>Как учить арабский с нуля →</strong></a><a href="/arabic-alphabet/"><span>Первый навык</span><strong>Арабский алфавит →</strong></a><a href="/fusha/"><span>Выбрать направление</span><strong>Что такое фусха →</strong></a></nav>
</GuideLayout>
