---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Приложение для изучения арабского языка с нуля | Acrab",
  "description": "Как выбрать приложение для изучения арабского языка: программа, теория, огласовки, аудирование и повторение. Возможности Acrab на русском.",
  "canonical": "https://acrab.ru/arabic-app/",
  "robots": "index, follow, max-image-preview:large",
  "ogTitle": "Приложение для изучения арабского языка — Acrab",
  "ogDescription": "Последовательная фусха, объяснения по-русски, огласовки, аудирование и повторение.",
  "ogType": "article",
  "ogImage": "https://acrab.ru/assets/about/program-home.webp",
  "ogImageAlt": "Главный экран приложения Acrab для изучения арабского языка",
  "twitterCard": "summary_large_image"
} as const;

const guide: GuideMeta = {
  headline: "Приложение для изучения арабского языка с нуля",
  description: seo.description,
  path: "/arabic-app/",
  image: seo.ogImage,
  datePublished: "2026-08-08",
  dateModified: "2026-10-01",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Приложение для арабского", path: "/arabic-app/" },
  ],
};

const faq = [
  {
    question: "Есть ли у Acrab бесплатная версия?",
    answer: "Да. Первые шесть глав программы доступны бесплатно и без ограничения по сроку: теория, все типы упражнений, озвучка, быстрые тренировки и синхронизация. Инструменты и ассистент в бесплатной версии работают с дневными лимитами.",
  },
  {
    question: "На каких устройствах работает Acrab?",
    answer: "На iPhone, iPad и Android. Приложение есть в App Store, Google Play и RuStore. Прогресс, огонёк и карточки синхронизируются между устройствами через один аккаунт.",
  },
  {
    question: "Нужно ли заранее знать арабский алфавит?",
    answer: "Нет. Программа начинается с первой буквы. Если алфавит уже знаком, тест уровня поможет начать с подходящей главы.",
  },
  {
    question: "Чему учит Acrab: литературному арабскому или диалекту?",
    answer: "Литературному арабскому, фусхе. Это общая письменная и официальная форма языка, которую понимают образованные носители во всех арабских странах.",
  },
  {
    question: "Как оформить Premium?",
    answer: "Premium открывает все 44 главы и повышает дневные лимиты инструментов и ассистента. Его можно оформить на месяц, на год или навсегда — в приложении или на странице оплаты сайта.",
  },
];
---

<GuideLayout {...seo} guide={guide}>
    <header class="guide-hero guide-hero-with-media product-guide-hero">
      <div>
        <p class="eyebrow">Acrab для iPhone, iPad и Android</p>
        <h1 class="page-title">Приложение для изучения арабского языка с нуля</h1>
        <p class="guide-lead">Acrab обучает литературному арабскому по-русски: от алфавита до чтения текста с полной огласовкой. Теория, упражнения, аудирование, повторение и учебные инструменты находятся в одном маршруте.</p>
        <div class="hero-downloads"><a class="button button-primary" href="https://apps.apple.com/ru/app/id6763663680" target="_blank" rel="noopener">Скачать в App Store</a><a class="button button-secondary" href="https://www.rustore.ru/catalog/app/com.acrab" target="_blank" rel="noopener">Скачать в RuStore</a><a class="button button-secondary" href="https://play.google.com/store/apps/details?id=com.acrab.arabic" target="_blank" rel="noopener">Скачать в Google Play</a></div>
        <p class="hero-fineprint">Первые 6 из 44 глав доступны бесплатно и без срока.</p>
        <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
      </div>
      <figure class="shot guide-hero-shot"><img src="/assets/about/program-home.webp" alt="Главный экран Acrab с программой и быстрыми тренировками" width="620" height="892" fetchpriority="high"></figure>
    </header>

    <div class="guide-layout">
      <aside class="guide-toc" aria-label="Содержание статьи"><strong>На этой странице</strong><a href="#criteria">Как выбрать приложение</a><a href="#program">Программа Acrab</a><a href="#practice">Как проходит урок</a><a href="#tools">Инструменты</a><a href="#free">Что бесплатно</a><a href="#faq">Частые вопросы</a></aside>
      <article class="guide-content">
        <section id="criteria">
          <h2>На что смотреть при выборе приложения</h2>
          <p>Количество карточек и яркий интерфейс сами по себе не показывают, чему вы научитесь. Проверьте пять вещей:</p>
          <ul class="guide-checklist"><li><strong>Есть ли последовательная программа.</strong> Следующий урок должен опираться на предыдущий.</li><li><strong>Объясняется ли грамматика.</strong> Ученик должен понимать правило до проверки ответа.</li><li><strong>Показаны ли огласовки.</strong> Начинающему важно видеть точное чтение нового слова.</li><li><strong>Есть ли работа со слухом.</strong> Одного визуального узнавания карточки недостаточно.</li><li><strong>Возвращаются ли забываемые слова.</strong> Повторение должно учитывать ошибки и время, а не просто листать один список.</li></ul>
        </section>

        <section id="program">
          <h2>Не набор тем, а маршрут из 44 глав</h2>
          <p>Acrab начинает с 28 букв и их соединения, затем переходит к приветствиям, рассказу о себе, артиклю <span class="arabic-inline" lang="ar" dir="rtl">ال</span>, именным предложениям и дальнейшей грамматике. Если алфавит уже знаком, тест уровня помогает начать с подходящего места.</p>
          <figure class="guide-proof"><img src="/assets/about/program-path.webp" alt="Последовательные модули программы Acrab" width="620" height="1250" loading="lazy"><figcaption>У каждой главы есть практическая цель и видимый прогресс. Будущие главы не подмешиваются в текущий урок.</figcaption></figure>
        </section>

        <section id="practice">
          <h2>Как проходит занятие</h2>
          <div class="lesson-flow"><div><span>1</span><strong>Понять</strong><p>Короткая теория по-русски объясняет новое правило и типичную ошибку.</p></div><div><span>2</span><strong>Применить</strong><p>Выбор перевода, сборка предложения и другие упражнения проверяют один навык.</p></div><div><span>3</span><strong>Услышать</strong><p>Фразы звучат без подсказки; при необходимости можно замедлить или показать текст.</p></div><div><span>4</span><strong>Вернуть вовремя</strong><p>Интервальное повторение отдельно собирает то, что пора освежить.</p></div></div>
        </section>

        <section id="tools">
          <h2>Инструменты остаются рядом с уроком</h2>
          <p>Когда встречается непонятная форма, не нужно собирать пять вкладок в браузере. В Acrab есть перевод, озвучка, тематический словарь, спряжение глаголов, примеры, поиск родственных слов по корню, расстановка огласовок и AI-ассистент с объяснениями по-русски.</p>
          <div class="proof-pair"><figure class="shot"><img src="/assets/about/tool-conjugation.webp" alt="Таблица спряжения арабского глагола в Acrab" width="620" height="1078" loading="lazy"></figure><figure class="shot"><img src="/assets/about/assistant.webp" alt="AI-ассистент Acrab объясняет арабскую грамматику по-русски" width="620" height="1218" loading="lazy"></figure></div>
        </section>

        <section id="free">
          <h2>Что можно попробовать бесплатно</h2>
          <p>Free — не временная демоверсия. Первые шесть глав, теория, упражнения, озвучка, быстрые тренировки, огонёк и синхронизация между устройствами доступны без ограничения по сроку. У инструментов и ассистента в бесплатной версии есть дневные лимиты.</p>
          <GuideCta title="Начните с подходящего уровня" text="Если уже читаете по-арабски, пройдите тест. Если нет — начните с первой буквы." />
        </section>

        <GuideFaq items={faq} />
      </article>
    </div>

    <nav class="related-guides" aria-label="Другие руководства"><a href="/learn-arabic/"><span>План обучения</span><strong>Как учить арабский с нуля →</strong></a><a href="/arabic-alphabet/"><span>Первый навык</span><strong>Арабский алфавит →</strong></a><a href="/fusha/"><span>Выбрать направление</span><strong>Что такое фусха →</strong></a></nav>
</GuideLayout>
