---
import PageLayout from "../../layouts/PageLayout.astro";
import Icon from "../../components/Icon.astro";
import { faqSchema } from "../../seo/schema";
import "../../styles/page-support.css";

// Ответы — HTML со ссылками; в разметку FAQPage идёт тот же текст без тегов.
const questions = [
  {
    question: "Как оплатить Premium на сайте?",
    answer: "Откройте страницу <a href=\"/buy/\">оплаты</a>, выберите тариф и подтвердите почту аккаунта Acrab кодом из письма. Оплата проходит на странице банка «Точка»: данные карты вы вводите у банка, к нам они не попадают. «Точка» сертифицирована по стандарту безопасности карт PCI DSS Level&nbsp;1.",
  },
  {
    question: "Когда включится Premium?",
    answer: "Обычно через несколько минут после оплаты: банк подтверждает платёж, и Premium включается на вашем аккаунте сам. Если доступа всё нет, откройте профиль в приложении заново. Не помогло — напишите нам почту аккаунта и примерное время оплаты.",
  },
  {
    question: "Premium продлевается автоматически?",
    answer: "Нет. Оплата на сайте разовая: на месяц, на год или навсегда. Автосписаний нет. Когда срок закончится, оплатите новый период тем же способом.",
  },
  {
    question: "Как вернуть деньги?",
    answer: "Если вы передумали до оплаты, просто закройте страницу банка: ссылка истечёт сама, деньги не спишутся. Если оплата уже прошла, напишите нам на почту адрес аккаунта, дату и сумму платежа. Ответим в течение 7 календарных дней. Если возврат положен, оформим его через банк «Точка» на ту же карту. Порядок возврата описан в разделе 6 <a href=\"/offer/\">публичной оферты</a>.",
  },
  {
    question: "Списание, которого вы не делали",
    answer: "Сразу напишите нам и пришлите данные операции. Мы проверим платёж в банке «Точка». Если списание не связано с вашими действиями, поможем оспорить его через банк.",
  },
  {
    question: "Как доставляется Premium?",
    answer: "Доставлять нечего: Premium — цифровая услуга. Он включается в приложении на аккаунте с подтверждённой почтой, обычно через несколько минут после того, как банк подтвердит оплату. Регион и стоимость доставки здесь не важны.",
  },
  {
    question: "Вопрос не про оплату",
    answer: "Нашли ошибку в уроке, не синхронизируется прогресс, ассистент ответил странно — напишите в Telegram или на почту поддержки. Скриншот и название урока помогут разобраться быстрее.",
  },
];
const plainText = (html: string) => html.replace(/<br\s*\/?>/g, " ").replace(/<[^>]+>/g, "").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();
const faq = faqSchema(questions.map((item) => ({ question: item.question, answer: plainText(item.answer) })));
---

<PageLayout section="support" title="Вопросы и поддержка Acrab: оплата Premium, возврат, контакты" description="Помощь Acrab: как оплатить Premium на сайте, когда он включится, как вернуть деньги, что делать при чужом списании и как связаться с поддержкой." canonical="https://acrab.ru/support/" ogTitle="Помощь и поддержка Acrab" ogDescription="Оплата Premium, возврат денег и контакты поддержки Acrab." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg" ogImageAlt="Иконка приложения Acrab" jsonLd={[faq]}>
<div class="page-head page-head-centered">
      <div class="page-head-inner">
        <p class="eyebrow">Помощь</p>
        <h1 class="page-title">Вопросы и ответы</h1>
        <p class="page-lead">Ответы про оплату Premium, возврат денег и работу приложения. Не нашли свой вопрос — напишите в Telegram или на почту.</p>
      </div>
    </div>

    <div class="panel-main">
      <section class="support-stack" aria-label="Вопросы и ответы" data-appear-group>
        <div class="support-contact card card-plain">
          <ul class="support-rows">
            <li class="support-row">
              <span class="icon-badge"><Icon name="telegram-logo" /></span>
              <span class="support-row-text"><span class="support-row-label">Telegram</span><strong>@musa_1756</strong></span>
            </li>
            <li class="support-row">
              <span class="icon-badge"><Icon name="envelope-simple" /></span>
              <span class="support-row-text"><span class="support-row-label">почта</span><a href="mailto:lagutkin.maksim.03@mail.ru?subject=Acrab%20Support">lagutkin.maksim.03@mail.ru</a></span>
            </li>
            <li class="support-row">
              <span class="icon-badge"><Icon name="phone" /></span>
              <span class="support-row-text"><span class="support-row-label">телефон</span><a href="tel:+79999988923">+7 999 998-89-23</a></span>
            </li>
          </ul>
          <a class="btn btn-block" href="https://t.me/musa_1756" target="_blank" rel="noopener">Написать в поддержку</a>
        </div>

        <div class="support-faq card card-plain">
          {questions.map((item) => (
            <article>
              <h2 class="t-headline">{item.question}</h2>
              <p set:html={item.answer} />
            </article>
          ))}

          <article>
            <h2 class="t-headline">Реквизиты и контакты</h2>
            <p>Услугу оказывает ИП Лагуткин Максим Дмитриевич, ИНН 650503291805, ОГРНИП 326650000012191 — правообладатель приложения Acrab.<br>
            Адрес: 694760, Сахалинская обл., с. Горнозаводск, ул. Советская, д. 31А<br>
            Почта: <a href="mailto:lagutkin.maksim.03@mail.ru?subject=Acrab%20Support">lagutkin.maksim.03@mail.ru</a><br>
            Телефон: <a href="tel:+79999988923">+7 999 998-89-23</a><br>
            Telegram поддержки: <a href="https://t.me/musa_1756" target="_blank" rel="noopener">@musa_1756</a><br>
            Документы: <a href="/offer/">публичная оферта</a>, <a href="/privacy/">политика обработки персональных данных</a>, <a href="/consent/">согласие на обработку данных</a>.</p>
          </article>
        </div>
      </section>
    </div>
</PageLayout>
