---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { faqSchema } from "../../seo/schema";

// Ответы — HTML со ссылками; в разметку FAQPage идёт тот же текст без тегов.
const questions = [
  {
    question: "Как оплатить Premium?",
    answer: "На странице <a href=\"/buy\">оплаты</a> подтвердите почту от аккаунта Acrab кодом из письма, выберите тариф и завершите оплату на защищённой странице банка «Точка» — эквайера, сертифицированного по PCI DSS Level&nbsp;1. Данные карты вводятся на стороне банка и не передаются нам.",
  },
  {
    question: "Когда активируется Premium?",
    answer: "Обычно сразу после успешной оплаты — банк подтверждает платёж, и приложение включает Premium автоматически. Если через несколько минут после оплаты доступ не появился, откройте профиль в приложении ещё раз или напишите нам с адресом почты и примерным временем оплаты.",
  },
  {
    question: "Продление и повторная оплата",
    answer: "Каждая оплата — разовая, на выбранный период (месяц или год); автоматического списания нет. Чтобы продолжить пользоваться Premium после окончания периода, оформите новую оплату тем же способом.",
  },
  {
    question: "Возврат и отмена платежа",
    answer: "Отменить оплату до её завершения можно просто закрыв страницу банка: неоплаченная ссылка истекает сама и Premium не включает. Если оплата уже прошла, напишите нам на почту с адресом аккаунта, датой и суммой платежа — разберём ситуацию и, если возврат обоснован, оформим его через банк «Точка» на карту, с которой была оплата. Ответ по обращению направляем в течение 7 календарных дней; порядок описан в разделе 6 <a href=\"/offer\">публичной оферты</a>.",
  },
  {
    question: "Не узнаю платёж / списание без моего ведома",
    answer: "Немедленно напишите нам с деталями операции. Мы проверим платёж по данным банка «Точка» и, если списание не связано с вашим действием, поможем оспорить его через стандартную процедуру банка-эквайера.",
  },
  {
    question: "Другие вопросы по приложению",
    answer: "По ошибкам в программе, синхронизации прогресса или работе AI-ассистента тоже пишите на почту поддержки — ответим как можно быстрее.",
  },
  {
    question: "Как доставляется Premium?",
    answer: "Никак — доставлять нечего. Услуга цифровая: физической отправки нет, регионы и стоимость доставки к ней неприменимы. Premium включается удалённо, прямо в приложении, на аккаунт с подтверждённой почтой, обычно в течение нескольких минут после подтверждения оплаты банком.",
  }
];
const plainText = (html: string) => html.replace(/<br\s*\/?>/g, " ").replace(/<[^>]+>/g, "").replace(/&nbsp;/g, " ").replace(/\s+/g, " ").trim();
const faq = faqSchema(questions.map((item) => ({ question: item.question, answer: plainText(item.answer) })));
---

<BaseLayout title="Вопросы и поддержка Acrab: оплата Premium, возврат, контакты" description="Поддержка Acrab: помощь с оплатой Premium, возвраты, оспаривание платежей, вопросы по приложению." canonical="https://acrab.ru/support/" ogTitle="Q/A и поддержка Acrab" ogDescription="Поддержка Acrab: помощь с оплатой Premium, возвраты, оспаривание платежей, вопросы по приложению." ogType="website" ogImage="https://acrab.ru/assets/acrab-icon-512.jpg" ogImageAlt="Иконка приложения Acrab" jsonLd={[faq]}>
  <a class="skip-link" href="#main">К содержанию</a>
  <Header active="support" />
  <main id="main">
<div class="page-head page-head-centered">
      <div class="page-head-inner">
        <p class="eyebrow">Q/A</p>
        <h1 class="page-title">Вопросы и ответы</h1>
        <p class="page-lead">Быстрые ответы по оплате Acrab Premium и работе приложения. Если вопроса нет в списке, напишите нам напрямую.</p>
      </div>
    </div>

    <div class="panel-main">
      <section class="panel panel-wide" aria-label="Вопросы и ответы">
        <div class="support-contact">
          <a class="button button-primary" href="https://t.me/musa_1756" target="_blank" rel="noopener">Написать в поддержку</a>
          <span class="support-contact-email">Telegram <strong>@musa_1756</strong> · почта <a href="mailto:lagutkin.maksim.03@mail.ru?subject=Acrab%20Support">lagutkin.maksim.03@mail.ru</a> · телефон <a href="tel:+79999988923">+7 999 998-89-23</a></span>
        </div>

        <div class="support-faq">
          {questions.map((item) => (
            <article>
              <h2>{item.question}</h2>
              <p set:html={item.answer} />
            </article>
          ))}

          <article>
            <h2>Реквизиты и контакты</h2>
            <p>Услугу оказывает ИП Лагуткин Максим Дмитриевич, ИНН 650503291805, ОГРНИП 326650000012191 — правообладатель приложения Acrab.<br>
            Адрес: 694760, Сахалинская обл., с. Горнозаводск, ул. Советская, д. 31А<br>
            Почта: <a href="mailto:lagutkin.maksim.03@mail.ru?subject=Acrab%20Support">lagutkin.maksim.03@mail.ru</a><br>
            Телефон: <a href="tel:+79999988923">+7 999 998-89-23</a><br>
            Telegram поддержки: <a href="https://t.me/musa_1756" target="_blank" rel="noopener">@musa_1756</a><br>
            Документы: <a href="/offer">публичная оферта</a>, <a href="/privacy">политика обработки персональных данных</a>, <a href="/consent">согласие на обработку данных</a>.</p>
          </article>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
