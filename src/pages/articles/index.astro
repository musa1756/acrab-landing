---
import PageLayout from "../../layouts/PageLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { GUIDES, GUIDE_GROUPS } from "../../seo/guides";
import { pageUrl } from "../../lib/routes";
import { breadcrumbSchema } from "../../seo/schema";
import "../../styles/page-guide.css";

const canonical = pageUrl("/articles/");
const groups = (Object.keys(GUIDE_GROUPS) as (keyof typeof GUIDE_GROUPS)[]).map((key) => ({
  title: GUIDE_GROUPS[key],
  guides: GUIDES.filter((guide) => guide.group === key),
}));
const collection = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Статьи об арабском языке",
  url: canonical,
  inLanguage: "ru",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: GUIDES.map((guide, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: guide.title,
      url: pageUrl(guide.href),
    })),
  },
};
const crumbs = [{ name: "Acrab", path: "/" }, { name: "Статьи", path: "/articles/" }];
---

<PageLayout section="articles" mainClass="guide-page" title="Статьи об арабском языке для начинающих | Acrab" description="Статьи для тех, кто учит арабский с нуля: план изучения, алфавит, огласовки, солнечные и лунные буквы, фусха и диалекты, выбор приложения." canonical={canonical} robots="index, follow, max-image-preview:large" ogTitle="Статьи об арабском языке — Acrab" ogDescription="План изучения, алфавит, огласовки, артикль и фусха — простыми словами на русском." ogType="website" ogImage="https://acrab.ru/assets/about/lesson-theory.webp" ogImageAlt="Урок теории по арабскому языку в Acrab" twitterCard="summary_large_image" jsonLd={[collection, breadcrumbSchema(crumbs)]}>
    <Breadcrumbs crumbs={crumbs} />
    <header class="guide-hero">
      <p class="eyebrow">Статьи</p>
      <h1 class="page-title">Статьи об арабском языке</h1>
      <p class="guide-lead">Руководства для тех, кто начинает учить литературный арабский: с чего начать, как читать буквы и огласовки, как заниматься, чтобы не бросить.</p>
    </header>
    {groups.map((group) => (
      <section class="articles-group" aria-label={group.title}>
        <h2>{group.title}</h2>
        <nav class="home-guides" data-appear-group>
          {group.guides.map((guide) => (
            <a href={guide.href}><span>{guide.kicker}</span><strong>{guide.title}</strong><p>{guide.summary}</p></a>
          ))}
        </nav>
      </section>
    ))}
</PageLayout>
