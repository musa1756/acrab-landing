---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Фусха: что такое литературный арабский язык | Acrab",
  "description": "Что такое фусха, где используют литературный арабский, чем он отличается от египетского и левантийского диалектов (с примерами) и что учить начинающему.",
  "canonical": "https://acrab.ru/fusha/",
  "robots": "index, follow, max-image-preview:large",
  "ogTitle": "Фусха: что такое литературный арабский",
  "ogDescription": "Где используют фусху, чем она отличается от диалектов и с чего начать обучение.",
  "ogType": "article",
  "ogImage": "https://acrab.ru/assets/about/lesson-listening.webp",
  "ogImageAlt": "Упражнение по аудированию литературного арабского в Acrab",
  "twitterCard": "summary_large_image"
} as const;

const guide: GuideMeta = {
  headline: "Что такое фусха и зачем её учить",
  description: seo.description,
  path: "/fusha/",
  image: seo.ogImage,
  datePublished: "2026-08-08",
  dateModified: "2026-10-01",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Фусха", path: "/fusha/" },
  ],
};

// Диалектные слова пишутся без огласовок, как их обычно и пишут носители.
const dialects = [
  ["Как дела?", "كَيْفَ حَالُكَ؟", "кайфа халюка", "إزيك", "иззайяк", "كيفك", "кифак"],
  ["Что?", "مَاذَا", "маза", "إيه", "эх", "شو", "шу"],
  ["Я хочу", "أُرِيدُ", "уриду", "عايز", "айиз", "بدي", "бидди"],
  ["Сейчас", "الْآنَ", "аль-ана", "دلوقتي", "дильваъти", "هلق", "халлаъ"],
] as const;

const faq = [
  {
    question: "Понимают ли фусху в арабских странах?",
    answer: "Образованные носители понимают её везде: на фусхе идут новости, написаны книги и учебники. В быту люди говорят на местном диалекте, поэтому на вопрос на фусхе вам могут ответить диалектом, но смысл разговора будет понятен.",
  },
  {
    question: "Можно ли говорить на фусхе в обычной жизни?",
    answer: "Можно, вас поймут. Для носителя такая речь звучит книжно и официально, примерно как если бы иностранец говорил по-русски языком новостей. Для общения это не мешает, а по мере знакомства с диалектом речь станет естественнее.",
  },
  {
    question: "Фусха и язык Корана — одно и то же?",
    answer: "Современная фусха выросла из классического арабского и сохраняет его письмо и грамматику. Отличается в основном словарь и стиль: в современных текстах много новых слов, а часть классической лексики встречается редко. Тому, кто знает современную фусху, гораздо проще читать и классические тексты.",
  },
  {
    question: "Что сложнее: фусха или диалект?",
    answer: "Для начала фусха понятнее: у неё стандартная грамматика и много учебных материалов с огласовками. Диалект проще в отдельных формах, но он сильнее различается от страны к стране и редко пишется.",
  },
];
---

<GuideLayout {...seo} guide={guide}>
    <header class="guide-hero">
      <p class="eyebrow">Литературный арабский</p>
      <h1 class="page-title">Что такое фусха и зачем её учить</h1>
      <p class="guide-lead"><strong>Фусха</strong> — общая литературная форма арабского языка. Она используется в книгах, новостях, официальных документах, образовании и подготовленной публичной речи.</p>
      <div class="fusha-word" lang="ar" dir="rtl"><span>اَلْعَرَبِيَّةُ الْفُصْحَى</span><small>аль-арабийя аль-фусха — литературный арабский язык</small></div>
      <div class="guide-answer"><strong>Коротко:</strong> фусха — единый письменный и официальный арабский для всех арабских стран. Диалекты — местная разговорная речь. Начинающему, который хочет читать и понимать арабский в целом, удобнее начать с фусхи.</div>
      <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
    </header>

    <div class="guide-layout">
      <aside class="guide-toc" aria-label="Содержание статьи"><strong>В этой статье</strong><a href="#where">Где встречается фусха</a><a href="#classical">Классическая и современная</a><a href="#difference">Фусха и диалекты</a><a href="#examples">Примеры различий</a><a href="#choice">Что выбрать</a><a href="#learn">Как учить фусху</a><a href="#faq">Частые вопросы</a></aside>
      <article class="guide-content">
        <section id="where">
          <h2>Где вы встретите литературный арабский</h2>
          <ul class="guide-checklist"><li>в новостях и официальных сообщениях;</li><li>в книгах, статьях и большинстве письменных учебных материалов;</li><li>в школьном и университетском образовании;</li><li>в документах, деловой переписке и формальных выступлениях;</li><li>в общении между людьми из разных арабских стран, когда местные диалекты сильно отличаются.</li></ul>
          <p>Это не означает, что люди постоянно разговаривают на фусхе дома или с друзьями. В повседневной речи обычно звучит местный диалект, а литературная форма остаётся общей письменной и формальной основой.</p>
        </section>

        <section id="classical">
          <h2>Классическая и современная фусха</h2>
          <p>Словом «фусха» называют две близкие формы. <strong>Классический арабский</strong> — язык Корана, классической поэзии и средневековой литературы. <strong>Современный литературный арабский</strong> — язык сегодняшних книг, прессы, телевидения и документов.</p>
          <p>Письмо, огласовки и основная грамматика у них общие. Отличаются словарь и стиль: в современном языке появились слова для новых понятий, а синтаксис ближе к газетному тексту. Большинство учебных программ, включая Acrab, учит современной фусхе: на ней проще начать говорить и читать актуальные тексты, а к классическим текстам потом можно перейти без новой грамматики.</p>
        </section>

        <section id="difference">
          <h2>Чем фусха отличается от разговорного диалекта</h2>
          <div class="comparison-pair">
            <div><span class="comparison-label">Фусха</span><h3>Общая система</h3><p>Стандартизированная грамматика и лексика. Подходит для чтения, образования и общения за пределами одной страны.</p></div>
            <div><span class="comparison-label">Диалект</span><h3>Живая местная речь</h3><p>Египетский, левантийский, диалекты стран Залива и другие варианты различаются произношением, словами и некоторыми конструкциями.</p></div>
          </div>
          <p>Противопоставлять их не нужно. Фусха отвечает на вопрос «как читать и понимать общий арабский», диалект — «как люди говорят в конкретной повседневной среде».</p>
        </section>

        <section id="examples">
          <h2>Примеры: одна фраза на фусхе и в диалектах</h2>
          <p>Различия заметнее всего в самых частых бытовых словах. В диалектах многие из них короче и звучат иначе:</p>
          <div class="guide-table-scroll">
            <table class="guide-table">
              <thead><tr><th scope="col">По-русски</th><th scope="col">Фусха</th><th scope="col">Египет</th><th scope="col">Левант</th></tr></thead>
              <tbody>
                {dialects.map(([russian, fusha, fushaReading, egypt, egyptReading, levant, levantReading]) => (
                  <tr>
                    <th scope="row">{russian}</th>
                    <td><span class="arabic-inline" lang="ar" dir="rtl">{fusha}</span><br /><small>{fushaReading}</small></td>
                    <td><span class="arabic-inline" lang="ar" dir="rtl">{egypt}</span><br /><small>{egyptReading}</small></td>
                    <td><span class="arabic-inline" lang="ar" dir="rtl">{levant}</span><br /><small>{levantReading}</small></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>Левантийские варианты — разговорная речь Сирии, Ливана, Иордании и Палестины. Фусху при этом понимают все: она звучит в новостях и на ней написаны книги в каждой из этих стран.</p>
        </section>

        <section id="choice">
          <h2>Что выбрать начинающему</h2>
          <div class="decision-list">
            <div><strong>Выбирайте фусху, если…</strong><ul><li>хотите читать и писать;</li><li>ещё не привязаны к одной стране;</li><li>нужна системная грамматическая основа;</li><li>планируете понимать материалы из разных регионов.</li></ul></div>
            <div><strong>Начинайте с диалекта, если…</strong><ul><li>скоро переезжаете в конкретную страну;</li><li>главная цель — бытовой разговор;</li><li>у вас есть семья или собеседники, говорящие на одном диалекте;</li><li>письменные тексты пока не приоритет.</li></ul></div>
          </div>
          <p>Комбинированный путь тоже возможен: фусха как основная программа и небольшая разговорная практика выбранного региона параллельно.</p>
        </section>

        <section id="learn">
          <h2>Как учить фусху последовательно</h2>
          <ol class="learning-steps compact-steps"><li><div><strong>Алфавит и огласовки</strong><p>Научитесь точно читать учебные примеры: <a href="/arabic-alphabet/">буквы</a>, <a href="/arabic-vowels/">огласовки</a>, <a href="/sun-moon-letters/">артикль</a>.</p></div></li><li><div><strong>Именные предложения</strong><p>Освойте род, число, определённость и согласование.</p></div></li><li><div><strong>Глагольная система</strong><p>Разбирайте формы постепенно и сразу используйте их в коротких фразах.</p></div></li><li><div><strong>Чтение и аудирование</strong><p>Увеличивайте длину текста, сохраняя понятную лексику и проверяемую озвучку.</p></div></li></ol>
          <p>В Acrab этот порядок разбит на 44 главы. Каждая глава показывает свою теорию по-русски и отрабатывает только ту лексику, которая нужна на текущем шаге.</p>
          <GuideCta title="Начните фусху с понятного маршрута" text="Первые шесть глав программы доступны бесплатно и не ограничены по времени." />
        </section>

        <GuideFaq items={faq} />
      </article>
    </div>

    <nav class="related-guides" aria-label="Другие руководства"><a href="/learn-arabic/"><span>Полный маршрут</span><strong>Как учить арабский с нуля →</strong></a><a href="/arabic-alphabet/"><span>Первый навык</span><strong>Арабский алфавит →</strong></a><a href="/arabic-app/"><span>Инструмент</span><strong>Как выбрать приложение →</strong></a></nav>
</GuideLayout>
