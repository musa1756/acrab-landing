---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Аль-Арабийя байна ядайк: структура и как заниматься | Acrab",
  "description": "Учебник «Аль-Арабийя байна ядайк» (الْعَرَبِيَّةُ بَيْنَ يَدَيْكَ): четыре уровня, кому подходит, ошибки при самообучении и как читать его в Acrab.",
  "ogTitle": "Аль-Арабийя байна ядайк: как заниматься по учебнику",
  "ogDescription": "Разбор четырёх уровней учебника «Байна ядайк», частые трудности самостоятельной учёбы и связка с приложением Acrab.",
  "ogImage": "https://acrab.ru/assets/about/library-books.webp",
  "ogImageAlt": "Полка Библиотеки в приложении Acrab с книгами на арабском языке"
} as const;

const guide: GuideMeta = {
  headline: "Аль-Арабийя байна ядайк: как заниматься по учебнику и закреплять лексику",
  description: seo.description,
  path: "/bayna-yadayk/",
  image: seo.ogImage,
  datePublished: "2026-11-24",
  dateModified: "2026-11-24",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Байна ядайк", path: "/bayna-yadayk/" },
  ],
};

const volumes = [
  [
    "Уровень 1 (части 1 и 2)",
    "Начальный",
    "Буквы и звуки, приветствия, знакомство, семья, дом, учёба, работа, покупки и распорядок дня.",
    "566 стр. (2 книги)",
  ],
  [
    "Уровень 2 (части 1 и 2)",
    "Средний",
    "Путешествия, здоровье, повседневный быт, общество и культура; разбор глаголов и расширение словаря.",
    "518 стр. (2 книги)",
  ],
  [
    "Уровень 3 (части 1 и 2)",
    "Продвинутый",
    "Наука, история, пресса, литературные и публицистические тексты; синтаксис и письменная речь.",
    "464 стр. (2 книги)",
  ],
  [
    "Уровень 4 (части 1 и 2)",
    "Высший",
    "Специализированные темы, источники без адаптации, академический и литературный арабский.",
    "516 стр. (2 книги)",
  ],
] as const;

const faq = [
  {
    question: "Можно ли начинать «Байна ядайк» с полного нуля?",
    answer: "Первый том начинается со звуков и простых диалогов, но весь учебник написан целиком по-арабски — без объяснений на русском. Полному новичку заметно проще сначала освоить алфавит, огласовки и базовое чтение, а затем открывать первый том.",
  },
  {
    question: "Сколько томов в новом издании «Аль-Арабийя байна ядайк»?",
    answer: "Во втором издании четыре уровня, и каждый уровень разделён на две части — всего восемь книг. Все восемь частей собраны в Библиотеке Acrab в формате PDF.",
  },
  {
    question: "Нужен ли интернет, чтобы читать «Байна ядайк» в Acrab?",
    answer: "Интернет нужен только один раз, чтобы скачать выбранную часть из Библиотеки на телефон или планшет. После загрузки книга открывается без сети.",
  },
  {
    question: "Какому арабскому учит «Байна ядайк»?",
    answer: "Современному литературному арабскому — фусхе. Это тот же стандарт, на котором построена основная программа Acrab, книги Библиотеки и новости в арабских странах.",
  },
  {
    question: "Зачем к учебнику добавлять приложение?",
    answer: "PDF-учебник даёт связные диалоги и тексты, но не проверяет произношение, не напоминает о забытых словах и не объясняет грамматику по-русски. В паре с Acrab вы закрепляете лексику интервальным повторением, сверяете глаголы в «Спряжении» и задаёте вопросы ИИ-ассистенту.",
  },
];
---

<GuideLayout {...seo} guide={guide}>
  <header class="guide-hero guide-hero-with-media product-guide-hero">
    <div>
      <p class="eyebrow">Учебник в Библиотеке</p>
      <h1 class="page-title">Аль-Арабийя байна ядайк: как заниматься по учебнику</h1>
      <p class="guide-lead"><strong>«Аль-Арабийя байна ядайк»</strong> (<span class="arabic-inline" lang="ar" dir="rtl">الْعَرَبِيَّةُ بَيْنَ يَدَيْكَ</span> — буквально «Арабский в твоих руках») — один из самых известных курсов современного литературного арабского. Разбираем, как устроены четыре уровня и как не бросить учебник при самостоятельной работе.</p>
      <div class="guide-answer card"><strong>Коротко:</strong> второе издание «Байна ядайк» состоит из четырёх уровней (восемь книг PDF). Учебник целиком на арабском, поэтому для самостоятельных занятий его удобнее сочетать с русскоязычными объяснениями, повторением слов и словарными инструментами — всё это есть рядом с книгой в Acrab.</div>
      <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
    </div>
    <figure class="shot guide-hero-shot"><img src="/assets/about/library-books.webp" alt="Библиотека в Acrab: полка с книгами и учебником «Байна ядайк»" width="620" height="1250" fetchpriority="high" /></figure>
  </header>

  <div class="guide-layout">
    <aside class="guide-toc" aria-label="Содержание статьи">
      <strong>В этой статье</strong>
      <a href="#structure">Четыре уровня учебника</a>
      <a href="#who">Кому подходит курс</a>
      <a href="#pitfalls">Трудности самообучения</a>
      <a href="#acrab">Как читать в Acrab</a>
      <a href="#plan">План работы с темой</a>
      <a href="#faq">Частые вопросы</a>
    </aside>

    <article class="guide-content">
      <section id="structure">
        <h2>Как устроены четыре уровня «Байна ядайк»</h2>
        <p>Курс составлен группой арабских методистов под руководством Абдуррахмана аль-Фаузана. В основе — живые бытовые диалоги на литературном арабском (<a href="/fusha/">фусхе</a>), которые постепенно усложняются до чтения публицистики и академических текстов. Второе издание разделено на четыре уровня по две части в каждом:</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Том</th>
                <th scope="col">Уровень</th>
                <th scope="col">Основные темы</th>
                <th scope="col">Объём</th>
              </tr>
            </thead>
            <tbody>
              {volumes.map(([vol, level, topics, pages]) => (
                <tr>
                  <th scope="row">{vol}</th>
                  <td>{level}</td>
                  <td>{topics}</td>
                  <td>{pages}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>На начальном уровне текст набран с полными огласовками, чтобы ученик привыкал к верному чтению. По мере перехода ко второму и третьему уровням тексты становятся длиннее, а грамматические упражнения — глубже.</p>
      </section>

      <section id="who">
        <h2>Кому подойдёт этот учебник</h2>
        <div class="decision-list" data-appear-group>
          <div class="card card-plain">
            <strong>Подходит, если вы…</strong>
            <ul>
              <li>уже знаете <a href="/arabic-alphabet/">алфавит</a> и базовые <a href="/arabic-vowels/">огласовки</a>;</li>
              <li>хотите системно расширять бытовой и учебный словарь на фусхе;</li>
              <li>готовы регулярно читать диалоги и закреплять новую лексику;</li>
              <li>занимаетесь с преподавателем или в связке с приложением.</li>
            </ul>
          </div>
          <div class="card card-plain">
            <strong>Что лучше пройти до первого тома</strong>
            <ul>
              <li>уверенное чтение соединённых букв (<a href="/how-to-read-arabic/">правила чтения</a>);</li>
              <li>артикль <span class="arabic-inline" lang="ar" dir="rtl">الـ</span> и <a href="/sun-moon-letters/">солнечные и лунные буквы</a>;</li>
              <li>базовые приветствия и простые именные фразы;</li>
              <li>привычку повторять новые слова через день и через неделю.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="pitfalls">
        <h2>Частые ошибки при самостоятельных занятиях</h2>
        <p>«Байна ядайк» создавался для аудитории с преподавателем, который объясняет новые конструкции на арабском. Когда ученик открывает PDF один, чаще всего мешают четыре вещи:</p>
        <div class="mistake-list card card-plain" data-appear>
          <div>
            <strong>Непонятная грамматика без перевода</strong>
            <p>Задания и рубрики в учебнике написаны по-арабски. Без пояснения по-русски легко пропустить разницу между формами глагола или причинами падежного окончания.</p>
          </div>
          <div>
            <strong>Слова выветриваются за неделю</strong>
            <p>В одной теме встречается 20–30 новых слов. Если просто прочитать диалог и перелистнуть страницу, через десять дней половина лексики забудется.</p>
          </div>
          <div>
            <strong>Чтение про себя без слуха</strong>
            <p>Без озвучки и проверки на слух глаз узнаёт слово в диалоге, но в живой речи оно звучит непривычно.</p>
          </div>
          <div>
            <strong>Попытка пройти том слишком быстро</strong>
            <p>Учебник рассчитан на постепенное накопление базы. Лучше разобрать один разворот с повторением слов, чем пролистать десять страниц за вечер.</p>
          </div>
        </div>
        <div class="guide-note card card-neutral card-warm">
          <strong>Учебник уже в Библиотеке Acrab:</strong> все восемь частей второго издания можно скачать в приложении и читать офлайн, а слова и правила сразу закреплять рядом.
          <div class="hero-downloads"><a class="btn btn-compact" href="/get/">Открыть Библиотеку в Acrab</a></div>
        </div>
      </section>

      <section id="acrab">
        <h2>Как сочетать «Байна ядайк» с Acrab</h2>
        <p>В Библиотеке Acrab лежат все восемь книг второго издания «Байна ядайк» в формате PDF — каждая скачивается отдельно и открывается без интернета. Рядом с книгой, не выходя из приложения, работают инструменты, которые закрывают слабые места самостоятельной учёбы:</p>
        <ul class="guide-checklist">
          <li><strong>Последовательная программа с теорией на русском:</strong> разбирает грамматику фусхи по шагам до того, как вы встретите её в диалогах учебника.</li>
          <li><strong>«Мои слова» и карточки Анки:</strong> добавляйте незнакомые слова из диалога и повторяйте их интервалами, пока они не перейдут в долгую память.</li>
          <li><strong>Инструменты «Перевод», «Спряжение» и «Семья слов»:</strong> позволяют за секунду проверить корень слова, формы глагола и точные огласовки.</li>
          <li><strong>ИИ-ассистент:</strong> отвечает по-русски на вопросы по конкретной фразе из диалога и помогает разобрать падежи.</li>
        </ul>
      </section>

      <section id="plan">
        <h2>Простой порядок работы с одним диалогом</h2>
        <ol class="learning-steps compact-steps">
          <li><div><strong>Прочитайте диалог вслух с огласовками</strong><p>Не спешите переводить каждое слово: сначала поймайте общий смысл и обратите внимание на знакомые корни.</p></div></li>
          <li><div><strong>Выпишите 5–10 новых слов</strong><p>Сохраните их в «Мои слова» в Acrab, чтобы они попали в карточки Анки и быстрые тренировки.</p></div></li>
          <li><div><strong>Разберите непонятную форму</strong><p>Если встретился новый глагол — откройте «Спряжение»; если неясно окончание — спросите у <a href="/ai-arabic-tutor/">ИИ-ассистента</a>.</p></div></li>
          <li><div><strong>Добавьте параллельное чтение</strong><p>Для коротких связных рассказов с пословным переводом по нажатию хорошо дополняет учебник книга <a href="/qiraa-rashida/">«аль-Кироату ар-Рашида»</a>.</p></div></li>
        </ol>
        <GuideCta title="Читайте «Байна ядайк» и закрепляйте лексику в Acrab" text="Скачайте части учебника в Библиотеке без интернета и совмещайте чтение с теорией по-русски, Анки и инструментами." />
      </section>

      <GuideFaq items={faq} />
    </article>
  </div>

  <nav class="related-guides" data-appear-group aria-label="Другие статьи">
    <a href="/qiraa-rashida/"><span>Первое чтение</span><strong>Аль-Кироату ар-Рашида →</strong></a>
    <a href="/learn-arabic/"><span>Полный маршрут</span><strong>Как выучить арабский с нуля →</strong></a>
    <a href="/arabic-app/"><span>Инструменты</span><strong>Приложение для изучения арабского →</strong></a>
  </nav>
</GuideLayout>
