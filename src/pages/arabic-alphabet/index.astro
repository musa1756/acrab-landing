---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";
import { letterByChar, letterPath } from "../../seo/letters";

const seo = {
  "title": "Арабский алфавит: все 28 букв с формами и звуками | Acrab",
  "description": "Арабский алфавит для начинающих: таблица 28 букв с названиями, звуками и формами в слове, шесть букв без соединения, огласовки и порядок изучения.",
  "canonical": "https://acrab.ru/arabic-alphabet/",
  "robots": "index, follow, max-image-preview:large",
  "ogTitle": "Арабский алфавит для начинающих",
  "ogDescription": "Таблица 28 букв с названиями и звуками, формы в слове, похожие буквы и огласовки.",
  "ogType": "article",
  "ogImage": "https://acrab.ru/assets/about/lesson-theory.webp",
  "ogImageAlt": "Урок теории по арабскому языку в Acrab",
  "twitterCard": "summary_large_image"
} as const;

const guide: GuideMeta = {
  headline: "Арабский алфавит для начинающих",
  description: seo.description,
  path: "/arabic-alphabet/",
  image: seo.ogImage,
  datePublished: "2026-08-08",
  dateModified: "2026-10-01",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Алфавит", path: "/arabic-alphabet/" },
  ],
};

// Формы перечислены в порядке «в начале, в середине, в конце слова»;
// в ячейке с dir="rtl" первая из них стоит справа.
const letters = [
  ["ا", "أَلِف", "алиф", "своего звука нет: тянет «а» и служит опорой для хамзы", "ا ـا ـا"],
  ["ب", "بَاء", "ба", "«б»", "بـ ـبـ ـب"],
  ["ت", "تَاء", "та", "«т»", "تـ ـتـ ـت"],
  ["ث", "ثَاء", "са", "глухой межзубный, как th в английском think", "ثـ ـثـ ـث"],
  ["ج", "جِيم", "джим", "«дж»", "جـ ـجـ ـج"],
  ["ح", "حَاء", "ха", "гортанный глухой «х», в русском аналога нет", "حـ ـحـ ـح"],
  ["خ", "خَاء", "ха", "глубокий хрипящий «х»", "خـ ـخـ ـخ"],
  ["د", "دَال", "даль", "«д»", "د ـد ـد"],
  ["ذ", "ذَال", "заль", "звонкий межзубный, как th в английском this", "ذ ـذ ـذ"],
  ["ر", "رَاء", "ра", "раскатистый «р»", "ر ـر ـر"],
  ["ز", "زَاي", "зай", "звонкий «з»", "ز ـز ـز"],
  ["س", "سِين", "син", "«с»", "سـ ـسـ ـس"],
  ["ش", "شِين", "шин", "«ш»", "شـ ـشـ ـش"],
  ["ص", "صَاد", "сад", "эмфатическое, «тяжёлое» «с»", "صـ ـصـ ـص"],
  ["ض", "ضَاد", "дад", "эмфатическое «д»", "ضـ ـضـ ـض"],
  ["ط", "طَاء", "та", "твёрдый «т» с тяжёлым нажимом", "طـ ـطـ ـط"],
  ["ظ", "ظَاء", "за", "эмфатический звонкий межзубный", "ظـ ـظـ ـظ"],
  ["ع", "عَيْن", "айн", "гортанный звонкий звук, в русском аналога нет", "عـ ـعـ ـع"],
  ["غ", "غَيْن", "гайн", "звонкий звук, похожий на картавое «р»", "غـ ـغـ ـغ"],
  ["ف", "فَاء", "фа", "«ф»", "فـ ـفـ ـف"],
  ["ق", "قَاف", "каф", "глубокий «к» из задней части нёба", "قـ ـقـ ـق"],
  ["ك", "كَاف", "кяф", "обычный «к»", "كـ ـكـ ـك"],
  ["ل", "لَام", "лям", "«л»", "لـ ـلـ ـل"],
  ["م", "مِيم", "мим", "«м»", "مـ ـمـ ـم"],
  ["ن", "نُون", "нун", "«н»", "نـ ـنـ ـن"],
  ["ه", "هَاء", "ха", "лёгкое придыхание, как английское h", "هـ ـهـ ـه"],
  ["و", "وَاو", "вав", "«в», ближе к английскому w, или долгий «у»", "و ـو ـو"],
  ["ي", "يَاء", "йа", "«й» или долгий «и»", "يـ ـيـ ـي"],
] as const;

// Каждая буква таблицы ведёт на свою страницу (src/seo/letters.ts).
const letterHref = (char: string) => {
  const page = letterByChar(char);
  return page ? letterPath(page.slug) : undefined;
};
const letterLabel = (char: string) => {
  const page = letterByChar(char);
  return page ? `Буква ${page.name}${page.qualifier ? `, ${page.qualifier}` : ""}` : undefined;
};

const lookalikes = [
  ["ب ت ث", "Зубчик: у ب одна точка снизу, у ت две сверху, у ث три сверху. В начале и середине слова так же выглядят ن (одна сверху) и ي (две снизу)."],
  ["ج ح خ", "Петля: у ج точка внутри снизу, у ح точки нет, у خ точка сверху."],
  ["د ذ", "Уголок: ذ отличается одной точкой сверху."],
  ["ر ز", "Хвост вниз: ز отличается одной точкой сверху."],
  ["س ش", "Три зубчика: у ش три точки сверху."],
  ["ص ض", "Вытянутая петля: у ض одна точка сверху."],
  ["ط ظ", "Петля с вертикальной чертой: у ظ одна точка сверху."],
  ["ع غ", "Открытый крючок: у غ одна точка сверху."],
  ["ف ق", "Круглая головка: у ف одна точка сверху, у ق две; в конце слова хвост ق глубже."],
] as const;

const faq = [
  {
    question: "Сколько букв в арабском алфавите?",
    answer: "В арабском алфавите 28 букв. Хамзу ء иногда называют 29-й буквой, но в основной список её обычно не включают. Короткие гласные «а», «и», «у» буквами не пишутся: их показывают огласовки.",
  },
  {
    question: "Есть ли в арабском заглавные буквы?",
    answer: "Нет. Арабское письмо не делит буквы на заглавные и строчные: предложение и имя начинаются так же, как любое слово. Форма буквы зависит только от места в слове и от того, соединяется ли она с соседними.",
  },
  {
    question: "Сколько времени нужно, чтобы выучить арабский алфавит?",
    answer: "Точного срока нет: он зависит от того, как часто вы занимаетесь. Лучше ориентироваться на результат. Алфавит освоен, когда вы узнаёте каждую букву в начале, середине и конце слова и без спешки читаете незнакомые слова с огласовками.",
  },
  {
    question: "Какие буквы не соединяются со следующей?",
    answer: "Шесть букв: ا د ذ ر ز و. С предыдущей буквой они соединяются, со следующей нет. Поэтому после них внутри слова остаётся разрыв, а следующая буква пишется в начальной форме.",
  },
  {
    question: "Нужно ли учиться писать арабские буквы от руки?",
    answer: "Для чтения достаточно уверенно узнавать буквы. Короткая практика письма всё же помогает: рука запоминает соединения и положение точек, и похожие буквы реже путаются при чтении.",
  },
];
---

<GuideLayout {...seo} guide={guide}>
    <header class="guide-hero">
      <p class="eyebrow">Основа чтения</p>
      <h1 class="page-title">Арабский алфавит для начинающих</h1>
      <p class="guide-lead">В арабском алфавите 28 букв. Текст читается справа налево, большинство букв соединяется с соседними, а короткие гласные показываются специальными знаками — огласовками.</p>
      <div class="alphabet-line card" lang="ar" dir="rtl" aria-label="Арабский алфавит">ا ب ت ث ج ح خ د ذ ر ز س ش ص ض ط ظ ع غ ف ق ك ل م ن ه و ي</div>
      <div class="guide-answer card"><strong>Коротко:</strong> 28 букв, письмо справа налево. У большинства букв по четыре формы, а шесть не соединяются со следующей. Короткие гласные «а», «и», «у» обозначаются огласовками над и под буквой.</div>
      <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
    </header>

    <div class="guide-layout">
      <aside class="guide-toc" aria-label="Содержание статьи"><strong>В этой статье</strong><a href="#principles">Как устроено письмо</a><a href="#table">Таблица 28 букв</a><a href="#forms">Формы букв</a><a href="#lookalikes">Похожие буквы</a><a href="#extra">Хамза и та марбута</a><a href="#vowels">Огласовки</a><a href="#plan">Порядок изучения</a><a href="#practice">Как тренироваться</a><a href="#faq">Частые вопросы</a></aside>
      <article class="guide-content">
        <section id="principles">
          <h2>Четыре вещи, которые нужно понять в начале</h2>
          <div class="principle-grid" data-appear-group>
            <div class="card card-plain"><strong>Справа налево</strong><p>Строка начинается справа, но цифры внутри текста сохраняют привычный порядок.</p></div>
            <div class="card card-plain"><strong>Буквы соединяются</strong><p>Слово пишется почти слитно, как русская пропись, поэтому границы букв приходится учиться замечать.</p></div>
            <div class="card card-plain"><strong>Форма меняется</strong><p>Одна и та же буква пишется по-разному: отдельно, в начале, в середине и в конце слова.</p></div>
            <div class="card card-plain"><strong>Точки различают буквы</strong><p>Общий «скелет» может быть одинаковым, а число и положение точек меняют букву и звук.</p></div>
          </div>
        </section>

        <section id="table">
          <h2>Таблица арабского алфавита</h2>
          <p>Буквы идут в словарном порядке. Русские названия приблизительные: три разные буквы называются «ха», две — «та». Поэтому рядом указаны арабское написание названия и описание звука. Нажмите на букву, чтобы открыть её страницу: звук, формы в слове, слова с переводом и похожие буквы.</p>
          <div class="guide-table-scroll card card-plain" data-appear>
            <table class="guide-table">
              <caption>Формы в слове записаны справа налево: в начале, в середине, в конце.</caption>
              <thead><tr><th scope="col">Буква</th><th scope="col">Название</th><th scope="col">Звук</th><th scope="col">Формы</th></tr></thead>
              <tbody>
                {letters.map(([letter, arabicName, name, sound, forms]) => (
                  <tr>
                    <th scope="row" class="ar" lang="ar" dir="rtl"><a href={letterHref(letter)} aria-label={letterLabel(letter)}>{letter}</a></th>
                    <td><a href={letterHref(letter)}>{name}</a><br /><span class="arabic-inline" lang="ar" dir="rtl">{arabicName}</span></td>
                    <td>{sound}</td>
                    <td class="ar ar-small letter-forms" lang="ar" dir="rtl">{forms.split(" ").map((form) => <span>{form}</span>)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>Шесть букв — <span class="arabic-inline" lang="ar" dir="rtl">ا د ذ ر ز و</span> — соединяются только с предыдущей буквой. Поэтому у них две формы вместо четырёх, а следующая за ними буква снова пишется как в начале слова.</p>
        </section>

        <section id="forms">
          <h2>Почему у одной буквы несколько форм</h2>
          <p>Возьмём букву <span class="arabic-inline" lang="ar" dir="rtl">ب</span> — «ба». Её основа остаётся узнаваемой, но соединительные линии зависят от места в слове:</p>
          <div class="arabic-example" lang="ar" dir="rtl" data-appear-group><span class="tile tile-gold">ب</span><span class="tile tile-gold">بـ</span><span class="tile tile-gold">ـبـ</span><span class="tile tile-gold">ـب</span></div>
          <p>Не зубрите каждую форму как отдельную букву. Запомните отличительный признак (здесь это одна точка снизу) и ищите букву в коротких словах: так глаз быстрее привыкает узнавать её без подсказки.</p>
          <div class="guide-note card card-neutral card-warm"><strong>Не путайте разрыв с пробелом.</strong> Шесть букв не соединяются со следующей буквой слева, и внутри слова иногда остаётся промежуток. В слове <span class="arabic-inline" lang="ar" dir="rtl">دَرْسٌ</span> («урок») ни <span class="arabic-inline" lang="ar" dir="rtl">د</span>, ни <span class="arabic-inline" lang="ar" dir="rtl">ر</span> не тянут линию к следующей букве.</div>
        </section>

        <section id="lookalikes">
          <h2>Похожие буквы: различайте по точкам</h2>
          <p>Многие буквы построены на одной основе и отличаются только точками. Если учить их группами, путаница исчезает быстрее, чем при заучивании по одной.</p>
          <div class="guide-table-scroll card card-plain" data-appear>
            <table class="guide-table">
              <thead><tr><th scope="col">Буквы</th><th scope="col">Чем отличаются</th></tr></thead>
              <tbody>
                {lookalikes.map(([group, hint]) => (
                  <tr><th scope="row" class="ar" lang="ar" dir="rtl">{group}</th><td>{hint}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section id="extra">
          <h2>Хамза, та марбута и другие знаки вне списка</h2>
          <p>В текстах встречаются знаки, которых нет среди 28 букв. Без них нельзя прочитать даже простые слова, поэтому их учат вместе с алфавитом.</p>
          <ul class="guide-checklist">
            <li><strong>Хамза <span class="arabic-inline" lang="ar" dir="rtl">ء</span></strong> — короткая смычка голоса, как пауза в русском «не-а». Пишется отдельно или на подставке: <span class="arabic-inline" lang="ar" dir="rtl">أ إ ؤ ئ</span>. Например, <span class="arabic-inline" lang="ar" dir="rtl">أَبٌ</span> — «отец».</li>
            <li><strong>Та марбута <span class="arabic-inline" lang="ar" dir="rtl">ة</span></strong> — окончание, чаще всего женского рода. На паузе звучит как «а», в слитной речи как «т»: <span class="arabic-inline" lang="ar" dir="rtl">غُرْفَةٌ</span> — «комната».</li>
            <li><strong>Алиф максура <span class="arabic-inline" lang="ar" dir="rtl">ى</span></strong> — долгий «а» в конце слова, пишется как <span class="arabic-inline" lang="ar" dir="rtl">ي</span> без точек: <span class="arabic-inline" lang="ar" dir="rtl">عَلَى</span> — «на».</li>
            <li><strong>Лям-алиф <span class="arabic-inline" lang="ar" dir="rtl">لا</span></strong> — сочетание <span class="arabic-inline" lang="ar" dir="rtl">ل</span> и <span class="arabic-inline" lang="ar" dir="rtl">ا</span>: когда после <span class="arabic-inline" lang="ar" dir="rtl">ل</span> идёт алиф, они сплетаются в один знак.</li>
          </ul>
        </section>

        <section id="vowels">
          <h2>Что такое огласовки</h2>
          <p>Короткие гласные записывают небольшими знаками над или под буквой. В учебниках они нужны, чтобы точно прочитать новое слово. Во многих повседневных текстах часть огласовок не пишут: знакомое слово читатель узнаёт по контексту.</p>
          <div class="vowel-row" aria-label="Примеры огласовок" data-appear-group>
            <div class="tile tile-gold"><span lang="ar" dir="rtl">بَ</span><strong>ба</strong><small>фатха</small></div>
            <div class="tile tile-gold"><span lang="ar" dir="rtl">بِ</span><strong>би</strong><small>касра</small></div>
            <div class="tile tile-gold"><span lang="ar" dir="rtl">بُ</span><strong>бу</strong><small>дамма</small></div>
            <div class="tile tile-gold"><span lang="ar" dir="rtl">بْ</span><strong>б</strong><small>сукун</small></div>
          </div>
          <p>Кроме этих четырёх знаков есть шадда (удвоение согласного) и танвин (окончания «ун», «ан», «ин»). Подробно, с примерами, их разбирает статья <a href="/arabic-vowels/">«Огласовки в арабском языке»</a>.</p>
          <p>Acrab показывает полную огласовку в словах, примерах и упражнениях, поэтому начинающему не приходится угадывать чтение.</p>
        </section>

        <section id="plan">
          <h2>В каком порядке учить буквы</h2>
          <p>Словарный порядок удобен для поиска, но не для запоминания. Легче идти от простых и частых букв к редким звукам, а похожие буквы брать парами.</p>
          <ol class="learning-steps compact-steps">
            <li><div><strong>Слушайте звук и смотрите на признак</strong><p>Форма, точки, место образования звука.</p></div></li>
            <li><div><strong>Найдите букву в трёх позициях</strong><p>В начале, середине и конце короткого слова.</p></div></li>
            <li><div><strong>Добавьте огласовки</strong><p>Прочитайте слоги с «а», «и», «у» и без короткой гласной.</p></div></li>
            <li><div><strong>Смешайте с уже знакомыми буквами</strong><p>Читайте новые слова, а не повторяйте одну строку по памяти.</p></div></li>
          </ol>
          <p>В Acrab алфавит устроен так же, в нём 15 уроков. Сначала <span class="arabic-inline" lang="ar" dir="rtl">ب م ا</span>, затем <span class="arabic-inline" lang="ar" dir="rtl">ت ن ل</span>. Следом идут первые слова с сукуном и танвином и долгие гласные с <span class="arabic-inline" lang="ar" dir="rtl">و</span> и <span class="arabic-inline" lang="ar" dir="rtl">ي</span>. Дальше буквы идут парами: <span class="arabic-inline" lang="ar" dir="rtl">د ر</span>, <span class="arabic-inline" lang="ar" dir="rtl">ك س</span>, <span class="arabic-inline" lang="ar" dir="rtl">ه ح</span>, <span class="arabic-inline" lang="ar" dir="rtl">ج خ</span>, <span class="arabic-inline" lang="ar" dir="rtl">ع غ</span>, <span class="arabic-inline" lang="ar" dir="rtl">ف ق</span>, <span class="arabic-inline" lang="ar" dir="rtl">ش ث</span>, <span class="arabic-inline" lang="ar" dir="rtl">ذ ز</span>. В конце — эмфатические <span class="arabic-inline" lang="ar" dir="rtl">ص ض ط ظ</span> и чтение с шаддой.</p>
        </section>

        <section id="practice">
          <h2>Как тренироваться без перегрузки</h2>
          <ul class="guide-checklist"><li>Берите небольшую группу похожих букв и сравнивайте их точки.</li><li>Читайте вслух, затем сверяйтесь с озвучкой.</li><li>Пишите рукой хотя бы одну строку: движение помогает заметить соединения.</li><li>Возвращайтесь к трудным буквам внутри новых слов, а не отдельными карточками.</li></ul>
          <GuideCta title="Пройдите алфавит по шагам" text="Алфавит в Acrab — первый из шести бесплатных модулей: 15 уроков, где к каждой букве сразу даны звук, чтение и упражнения." />
        </section>

        <GuideFaq items={faq} />
      </article>
