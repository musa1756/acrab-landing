---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PaymentFlow from "../../features/payment/PaymentFlow";
---

<BaseLayout title="Оплата Acrab Premium" description="Оплата Acrab Premium: подтвердите почту аккаунта, выберите тариф и оплатите через банк «Точка»." robots="noindex">
  <a class="skip-link" href="#main">К содержанию</a>
  <Header active="buy" />
  <main id="main">
<div class="page-head page-head-centered">
      <div class="page-head-inner">
        <p class="eyebrow">Acrab Premium</p>
        <h1 class="page-title">Оплата</h1>
        <p class="page-lead">Подтвердите почту от аккаунта Acrab, выберите тариф и оплатите через защищённую страницу банка «Точка». Данные карты вводятся на стороне банка и не хранятся у нас.</p>
      </div>
    </div>

    <div class="panel-main">
      <section class="panel" aria-labelledby="buy-title">
        <h2 id="buy-title" class="auth-title">Вход по почте</h2>
        <p class="auth-lead">Premium привязывается к тому же аккаунту, с которым вы занимаетесь в приложении.</p>

        <PaymentFlow client:load />

        <p class="auth-footnote">Обработку платежа выполняет банк «Точка» (эквайринг, соответствует PCI DSS Level&nbsp;1). Мы не получаем и не храним данные вашей карты. Каждая оплата разовая, на выбранный период — автосписания нет. Услуга цифровая: доставка не требуется, Premium активируется в приложении автоматически после подтверждения оплаты банком, обычно в течение нескольких минут. Вопросы по оплате — на <a href="/support">странице Q/A</a>.</p>
      </section>

      <!-- Цифры сверены с AIQuotaScope (freeDailyLimit / premiumDailyLimit) и
           FushaProgramAccessPolicy в приложении. Меняются лимиты — правится и
           эта таблица, иначе сайт начнёт обещать не то, что выдаёт приложение. -->
      <section class="compare" aria-labelledby="compare-title">
        <h2 class="compare-title" id="compare-title">Что даёт Premium</h2>
        <p class="compare-lead">Free остаётся бесплатным без ограничения по времени. Premium снимает границу программы и поднимает дневные лимиты инструментов.</p>

        <div class="compare-scroll">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">Возможность</th>
                <th scope="col">Free</th>
                <th scope="col" class="is-premium">Premium</th>
              </tr>
            </thead>
            <tbody>
              <tr class="compare-group"><th scope="colgroup" colspan="3">Программа</th></tr>
              <tr>
                <th scope="row">Главы программы</th>
                <td>Первые 6 глав</td>
                <td class="is-premium">Все 44 главы</td>
              </tr>
              <tr>
                <th scope="row">Уроки, упражнения, интервальное повторение</th>
                <td><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
                <td class="is-premium"><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
              </tr>
              <tr>
                <th scope="row">Озвучка слов и фраз в уроках</th>
                <td><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
                <td class="is-premium"><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
              </tr>

              <tr class="compare-group"><th scope="colgroup" colspan="3">Инструменты — лимит на день</th></tr>
              <tr>
                <th scope="row">AI-учитель, сообщений</th>
                <td>10</td>
                <td class="is-premium">100</td>
              </tr>
              <tr>
                <th scope="row">Перевод, символов</th>
                <td>1 000</td>
                <td class="is-premium">30 000</td>
              </tr>
              <tr>
                <th scope="row">Огласовки текста, символов</th>
                <td>1 000</td>
                <td class="is-premium">30 000</td>
              </tr>
              <tr>
                <th scope="row">Огласовки по фото</th>
                <td>Без лимита</td>
                <td class="is-premium">Без лимита</td>
              </tr>
              <tr>
                <th scope="row">Словарь по теме, запросов</th>
                <td>3</td>
                <td class="is-premium">100</td>
              </tr>
              <tr>
                <th scope="row">Примеры со словом, запросов</th>
                <td>3</td>
                <td class="is-premium">50</td>
              </tr>
              <tr>
                <th scope="row">Картинки для флешкарт</th>
                <td>5</td>
                <td class="is-premium">Без лимита</td>
              </tr>
              <tr>
                <th scope="row">Озвучка текста, символов</th>
                <td>400</td>
                <td class="is-premium">10 000</td>
              </tr>
              <tr>
                <th scope="row">Спряжения глаголов и семьи слов</th>
                <td>Без лимита</td>
                <td class="is-premium">Без лимита</td>
              </tr>

              <tr class="compare-group"><th scope="colgroup" colspan="3">Огонёк и прогресс</th></tr>
              <tr>
                <th scope="row">Заморозки огонька</th>
                <td>2</td>
                <td class="is-premium">2</td>
              </tr>
              <tr>
                <th scope="row">Автовосстановление сгоревшего огонька</th>
                <td><span class="mark mark-no" aria-hidden="true">—</span><span class="visually-hidden">нет</span></td>
                <td class="is-premium"><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
              </tr>
              <tr>
                <th scope="row">Синхронизация прогресса между устройствами</th>
                <td><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
                <td class="is-premium"><span class="mark mark-yes" aria-hidden="true">✓</span><span class="visually-hidden">есть</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="compare-note">Бесплатный маршрут программы заканчивается на главе «Семья и люди». Лимиты инструментов обнуляются каждый день; когда дневной лимит исчерпан, уроки продолжают работать как обычно.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
