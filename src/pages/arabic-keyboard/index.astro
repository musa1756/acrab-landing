---
import GuideLayout from "../../layouts/GuideLayout.astro";
import ArabicKeyboard from "../../components/ArabicKeyboard.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { ARABIC_KEYS_BY_CODE, charForCode } from "../../scripts/arabic-keyboard-model";
import { formatRuDate, webApplicationSchema, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Арабская клавиатура онлайн: печать букв и огласовок | Acrab",
  "description": "Бесплатная арабская клавиатура онлайн: буквы, огласовки и хамза, ввод с обычной клавиатуры, копирование и русская транслитерация. Без установки.",
  "canonical": "https://acrab.ru/arabic-keyboard/",
  "robots": "index, follow, max-image-preview:large",
  "ogTitle": "Арабская клавиатура онлайн",
  "ogDescription": "Печатайте арабские буквы и огласовки с экрана или обычной клавиатуры и копируйте готовый текст.",
  "ogType": "website",
  "ogImage": "https://acrab.ru/assets/about/lesson-theory.webp",
  "ogImageAlt": "Урок теории по арабскому языку в Acrab",
  "twitterCard": "summary_large_image"
} as const;

const guide: GuideMeta = {
  headline: "Арабская клавиатура онлайн",
  description: seo.description,
  path: "/arabic-keyboard/",
  image: seo.ogImage,
  datePublished: "2026-10-01",
  dateModified: "2026-10-01",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Арабская клавиатура", path: "/arabic-keyboard/" },
  ],
};

// Знаки и клавиши берутся из той же модели, что и сама клавиатура, поэтому таблицы не разойдутся с ней.
const legend = (code: string, shifted: boolean) => {
  const key = ARABIC_KEYS_BY_CODE[code]!;
  return `${shifted ? "Shift + " : ""}${key.latin} (${key.ru})`;
};

const harakat = [
  ["KeyQ", "Фатха", "короткий «а»"],
  ["KeyE", "Дамма", "короткий «у»"],
  ["KeyA", "Касра", "короткий «и»"],
  ["KeyX", "Сукун", "гласного нет"],
  ["Backquote", "Шадда", "согласный удваивается"],
  ["KeyW", "Танвин фатхи", "окончание «ан»"],
  ["KeyR", "Танвин даммы", "окончание «ун»"],
  ["KeyS", "Танвин касры", "окончание «ин»"],
] as const;

const hamza: readonly [code: string, shifted: boolean, name: string][] = [
  ["KeyX", false, "Хамза"],
  ["KeyH", true, "Алиф с хамзой сверху"],
  ["KeyY", true, "Алиф с хамзой снизу"],
  ["KeyN", true, "Алиф с мадда"],
  ["KeyC", false, "Хамза на вав"],
  ["KeyZ", false, "Хамза на йа"],
  ["KeyB", false, "Лям-алиф"],
  ["KeyG", true, "Лям-алиф с хамзой сверху"],
  ["KeyT", true, "Лям-алиф с хамзой снизу"],
  ["KeyB", true, "Лям-алиф с мадда"],
];

const faq = [
  {
    question: "Как набрать арабский текст на компьютере без установки раскладки?",
    answer: "Откройте эту страницу, включите переключатель «Печатать с клавиатуры компьютера» и кликните в поле. Каждая клавиша даст арабскую букву по раскладке «Арабская (101)»: Q — ض, W — ص, A — ش. Готовый текст скопируйте кнопкой «Копировать» и вставьте в документ или переписку.",
  },
  {
    question: "Как поставить огласовки и шадду?",
    answer: "Нажмите Shift вместе с буквенной клавишей: Shift + Q даёт фатху, Shift + E — дамму, Shift + A — касру, Shift + X — сукун, Shift + ` — шадду. Знак ставится после буквы, к которой относится: сначала буква, потом знак. На экранной клавиатуре нажмите Shift, затем нужный знак; слой сам вернётся к буквам.",
  },
  {
    question: "Как набрать хамзу: أ, إ, ؤ, ئ?",
    answer: "Алиф с хамзой сверху — Shift + H, с хамзой снизу — Shift + Y, алиф с мадда — Shift + N. Отдельная хамза — клавиша X, хамза на вав — C, хамза на йа — Z.",
  },
  {
    question: "Почему цифры получаются арабскими?",
    answer: "Цифры верхнего ряда дают восточные арабские цифры ٠١٢٣٤٥٦٧٨٩, как в раскладке «Арабская (101)» в Windows. Обычные 0–9 можно набрать на цифровом блоке клавиатуры справа или при выключенном переключателе.",
  },
  {
    question: "Насколько точна транслитерация?",
    answer: "Приблизительная. Она читает только то, что написано: без огласовок гласных в записи нет, поэтому вы увидите одни согласные. Звуки, которых нет в русском, передаются близкими: ح и خ — «х», ص и س — «с». Артикль «аль» и слияние с солнечными буквами не учитываются. Чтобы выучить произношение, слушайте озвучку слов, а не читайте транслитерацию.",
  },
  {
    question: "Остаётся ли набранный текст на сайте?",
    answer: "Нет. Текст остаётся в поле на странице: сайт не отправляет его на сервер и не сохраняет. Если закрыть вкладку, он пропадёт, поэтому скопируйте нужное заранее.",
  },
];

const toolSchema = webApplicationSchema({
  name: "Арабская клавиатура онлайн",
  description: seo.description,
  path: "/arabic-keyboard/",
});
---

<GuideLayout {...seo} guide={guide}>
    <header class="guide-hero tool-hero">
      <p class="eyebrow">Бесплатный инструмент</p>
      <h1 class="page-title">Арабская клавиатура онлайн</h1>
      <p class="guide-lead">Печатайте арабские буквы и огласовки: нажимайте клавиши на экране или включите ввод с обычной клавиатуры, и латинские клавиши дадут арабские буквы. Готовый текст копируется одной кнопкой, ничего устанавливать не нужно.</p>
      <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
    </header>

    <ArabicKeyboard />

    <div class="guide-layout">
      <aside class="guide-toc" aria-label="Содержание страницы"><strong>На странице</strong><a href="#usage">Как пользоваться</a><a href="#shift">Огласовки и хамза</a><a href="#install">Раскладка в системе</a><a href="#next">Что дальше</a><a href="#faq">Частые вопросы</a></aside>
      <article class="guide-content">
        <section id="usage">
          <h2>Как пользоваться клавиатурой</h2>
          <p>Нажимайте клавиши мышью или пальцем: буква появится в поле там, где стоит курсор. Арабский текст идёт справа налево, поэтому курсор начинает с правого края.</p>
          <ul class="guide-checklist">
            <li><strong>Буквы с компьютерной клавиатуры.</strong> Включите «Печатать с клавиатуры компьютера» и кликните в поле: клавиша Q даст <span class="arabic-inline" lang="ar" dir="rtl">ض</span>, A — <span class="arabic-inline" lang="ar" dir="rtl">ش</span>, Z — <span class="arabic-inline" lang="ar" dir="rtl">ئ</span>. Важно положение клавиши, а не буква на ней, поэтому при русской раскладке системы Q — это «й».</li>
            <li><strong>Огласовки и хамза.</strong> Кнопка Shift на экране меняет клавиши на огласовки, хамзу и знаки препинания и действует на одно нажатие. С компьютерной клавиатуры используйте обычный Shift.</li>
            <li><strong>Правка.</strong> Кнопка ⌫ стирает один символ: огласовка стирается отдельно от буквы, ведь вы поставили её последней. Клавиша «Пробел» и кнопка ↵ работают как обычно.</li>
            <li><strong>Копирование.</strong> «Копировать» кладёт весь текст в буфер обмена, «Очистить» очищает поле. Переключатель «Транслитерация» показывает под полем приблизительное русское чтение.</li>
          </ul>
          <p>Расположение букв повторяет раскладку «Арабская (101)» в Windows. В правом верхнем углу каждой клавиши мелким шрифтом показан знак, который она даёт с Shift, а в левом нижнем — латинская клавиша, на которой она лежит.</p>
        </section>

        <section id="shift">
          <h2>Огласовки и хамза: что даёт Shift</h2>
          <p>Огласовки — это знаки над и под буквами. Их значение разобрано в статье про <a href="/arabic-vowels/">огласовки</a>. В скобках указана буква на той же клавише в русской раскладке.</p>
          <div class="guide-table-scroll card card-plain" data-appear>
            <table class="guide-table">
              <caption>Огласовки</caption>
              <thead><tr><th scope="col">Знак</th><th scope="col">Название</th><th scope="col">Клавиши</th></tr></thead>
              <tbody>
                {harakat.map(([code, name, sound]) => (
                  <tr>
                    <th scope="row" class="ar" lang="ar" dir="rtl">{`ب${charForCode(code, true)}`}</th>
                    <td><strong>{name}</strong><br /><small>{sound}</small></td>
                    <td>{legend(code, true)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="guide-table-scroll card card-plain" data-appear>
            <table class="guide-table">
              <caption>Хамза и лям-алиф</caption>
              <thead><tr><th scope="col">Знак</th><th scope="col">Название</th><th scope="col">Клавиши</th></tr></thead>
              <tbody>
                {hamza.map(([code, shifted, name]) => (
                  <tr>
                    <th scope="row" class="ar" lang="ar" dir="rtl">{charForCode(code, shifted)}</th>
                    <td>{name}</td>
                    <td>{legend(code, shifted)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="guide-note card card-neutral card-warm"><strong>Подсказка:</strong> огласовку ставят после буквы, к которой она относится. Сначала нажмите букву, затем Shift и знак: так порядок в тексте будет правильным.</div>
        </section>

        <section id="install">
          <h2>Как добавить арабскую раскладку в систему</h2>
          <p>Онлайн-клавиатура удобна для коротких фраз. Если вы часто печатаете по-арабски в других программах, добавьте арабский язык ввода в систему. В Windows раскладка «Арабская (101)» совпадает с этой клавиатурой; на Mac и телефонах буквы расположены похоже, а цифры и знаки препинания могут отличаться, поэтому ориентируйтесь на подписи клавиш.</p>

          <h3>Windows 10 и 11</h3>
          <ol class="kbd-steps">
            <li>Откройте «Параметры» → «Время и язык» → «Язык» (в Windows 11 — «Язык и регион»).</li>
            <li>Нажмите «Добавить язык» и выберите арабский, например «Арабский (Саудовская Аравия)». Дополнительные компоненты можно не ставить.</li>
            <li>Откройте «Языковые параметры» этого языка (в Windows 11 — кнопка «…» рядом с ним) и проверьте раздел «Клавиатуры»: там должна быть «Арабская (101)». Если её нет, нажмите «Добавить клавиатуру».</li>
            <li>Переключайте раскладки сочетанием Win + Пробел или Alt + Shift.</li>
          </ol>

          <h3>macOS</h3>
          <ol class="kbd-steps">
            <li>Откройте меню Apple → «Системные настройки» → «Клавиатура».</li>
            <li>В разделе «Ввод текста» нажмите «Изменить…» рядом с «Источники ввода» (в старых версиях macOS это вкладка «Источники ввода»).</li>
            <li>Нажмите «+», выберите «Арабский» и добавьте раскладку «Арабская».</li>
            <li>Переключайте раскладки сочетанием Control + Пробел или клавишей с глобусом.</li>
          </ol>

          <h3>iPhone и iPad</h3>
          <ol class="kbd-steps">
            <li>Откройте «Настройки» → «Основные» → «Клавиатура» → «Клавиатуры».</li>
            <li>Нажмите «Новые клавиатуры…» и выберите «Арабский».</li>
            <li>В любом поле ввода нажмите значок глобуса на клавиатуре (или удерживайте его) и выберите арабскую раскладку.</li>
          </ol>

          <h3>Android</h3>
          <ol class="kbd-steps">
            <li>Откройте «Настройки» → «Система» → «Язык и ввод» → «Экранная клавиатура» → Gboard → «Языки».</li>
            <li>Нажмите «Добавить клавиатуру», выберите «Арабский» и подходящую раскладку, затем «Готово».</li>
            <li>В поле ввода нажмите значок глобуса или удерживайте пробел, чтобы переключить язык.</li>
          </ol>
          <p>Названия пунктов зависят от версии системы и производителя телефона.</p>
        </section>

        <section id="next">
          <h2>Что дальше: чтение и огласовки</h2>
          <p>Чтобы набирать арабские слова без подсказок, нужно знать буквы и огласовки. Начните со статьи про <a href="/arabic-alphabet/">арабский алфавит</a>: там все 28 букв с названиями, звуками и формами в слове. Знаки со слоя Shift разобраны в статье про <a href="/arabic-vowels/">огласовки</a>.</p>
          <GuideCta title="Учить буквы удобнее в приложении" text="В Acrab каждая буква и огласовка идут с озвучкой, упражнениями и повторением. Первые шесть модулей бесплатны и без срока." />
        </section>

        <GuideFaq items={faq} />
      </article>
    </div>

    <nav class="related-guides" data-appear-group aria-label="Другие статьи"><a href="/arabic-alphabet/"><span>Основа</span><strong>Арабский алфавит →</strong></a><a href="/arabic-vowels/"><span>Знаки на слое Shift</span><strong>Огласовки →</strong></a><a href="/learn-arabic/"><span>Полный маршрут</span><strong>Как учить арабский с нуля →</strong></a></nav>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(toolSchema)} />
</GuideLayout>
