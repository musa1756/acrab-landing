---
import GuideLayout from "../../layouts/GuideLayout.astro";
import GuideCta from "../../components/GuideCta.astro";
import GuideFaq from "../../components/GuideFaq.astro";
import { formatRuDate, type GuideMeta } from "../../seo/schema";

const seo = {
  "title": "Аналоги Duolingo для арабского языка на русском | Acrab",
  "description": "Почему в Duolingo нет курса арабского на русском и какие есть альтернативы: честное сравнение Acrab, Duolingo, Busuu, Drops, AlifBee и самоучителей.",
  "ogTitle": "Аналоги Duolingo для изучения арабского на русском",
  "ogDescription": "Сравнение Acrab, Duolingo, Busuu, Drops, AlifBee и учебников по огласовкам, грамматике на русском, озвучке и доступности в магазинах.",
  "ogImage": "https://acrab.ru/assets/about/program-path.webp",
  "ogImageAlt": "Экран программы изучения арабского языка в приложении Acrab"
} as const;

const guide: GuideMeta = {
  headline: "Аналоги Duolingo для изучения арабского языка на русском",
  description: seo.description,
  path: "/duolingo-arabic/",
  image: seo.ogImage,
  datePublished: "2026-11-24",
  dateModified: "2026-11-24",
  crumbs: [
    { name: "Acrab", path: "/" },
    { name: "Статьи", path: "/articles/" },
    { name: "Аналоги Duolingo для арабского", path: "/duolingo-arabic/" },
  ],
};

const comparison = [
  [
    "Acrab",
    "Да, теория до упражнений",
    "Полные во всех примерах и заданиях",
    "Синтезированная озвучка и аудирование",
    "Через 1, 7 и 30 дней + Анки",
    "App Store, Google Play, RuStore",
  ],
  [
    "Duolingo",
    "Курса с русского нет (только с английского)",
    "Частично на старте, дальше часто без них",
    "Есть",
    "Короткие повторы внутри ветки",
    "App Store, Google Play (нет в RuStore)",
  ],
  [
    "Busuu",
    "Ограниченно, часть объяснений краткая",
    "Частично",
    "Есть",
    "Повторение слов в платном тарифе",
    "App Store, Google Play (нет в RuStore)",
  ],
  [
    "Drops",
    "Нет: только словарный запас",
    "Не всегда полные",
    "Озвучка отдельных слов",
    "Карточки по 5 минут в день",
    "App Store, Google Play (нет в RuStore)",
  ],
  [
    "AlifBee",
    "Русского интерфейса и теории нет",
    "Есть на начальных уровнях",
    "Есть",
    "Повторение пройденных слов",
    "App Store, Google Play (нет в RuStore)",
  ],
  [
    "Учебники и самоучители",
    "Зависит от книги (в арабских учебниках — нет)",
    "Есть в книгах для начинающих",
    "Отдельные аудиофайлы",
    "Нужно вести карточки вручную",
    "Бумага или PDF",
  ],
] as const;

const faq = [
  {
    question: "Есть ли в Duolingo курс арабского на русском языке?",
    answer: "Нет. В Duolingo арабский доступен только для тех, кто учит его через английский интерфейс. Если вы хотите читать объяснения грамматики, падежей и огласовок по-русски, удобнее выбрать приложение с русскоязычной программой.",
  },
  {
    question: "Почему для арабского не хватает только игровых карточек?",
    answer: "В арабском слова меняются по корням, родам, числам и падежам, а без огласовок одно и то же написание читается по-разному. Игровые задания помогают запомнить десятки слов, но без понятной теории до упражнения быстро появляется ощущение, что вы угадываете ответ.",
  },
  {
    question: "Какое приложение для арабского можно скачать в RuStore?",
    answer: "Acrab доступен официально в трёх магазинах сразу: App Store для iPhone и iPad, Google Play и RuStore для Android. Большинство зарубежных сервисов вроде Duolingo, Busuu, Drops и AlifBee в RuStore не представлены.",
  },
  {
    question: "Можно ли сочетать приложение и учебник?",
    answer: "Да, это один из самых рабочих вариантов. Приложение даёт ежедневный ритм, озвучку и интервальное повторение, а учебник или книга для чтения закрепляют длинные тексты. В Acrab учебники «Байна ядайк» и книга «аль-Кироату ар-Рашида» собраны прямо в Библиотеке.",
  },
  {
    question: "Можно ли попробовать Acrab бесплатно?",
    answer: "Да. Стартовый курс с алфавитом, первыми фразами и упражнениями доступен бесплатно без ограничения по сроку. Также в бесплатной версии работают быстрые тренировки, Анки, серия занятий и дневные лимиты инструментов и ИИ-ассистента.",
  },
];
---

<GuideLayout {...seo} guide={guide}>
  <header class="guide-hero">
    <p class="eyebrow">Сравнение сервисов</p>
    <h1 class="page-title">Аналоги Duolingo для изучения арабского языка на русском</h1>
    <p class="guide-lead">Многие начинают искать приложение для арабского с привычного Duolingo, но сталкиваются с двумя ограничениями: курса с русского языка там нет, а на Android в России сервис отсутствует в RuStore. Разбираем, чем заменить Duolingo и на что смотреть при выборе.</p>
    <div class="guide-answer card"><strong>Коротко:</strong> в Duolingo арабский доступен только через английский и без системной грамматики. Если вам нужны объяснения на русском, полные огласовки, интервальное повторение и официальная установка на iOS, Android и RuStore, подойдёт Acrab; для отдельных слов как дополнение используют Drops, а для системного чтения — связку приложения и учебника.</div>
    <p class="guide-updated">Обновлено <time datetime={guide.dateModified}>{formatRuDate(guide.dateModified)}</time></p>
  </header>

  <div class="guide-layout">
    <aside class="guide-toc" aria-label="Содержание статьи">
      <strong>В этой статье</strong>
      <a href="#why-not">Почему ищут замену Duolingo</a>
      <a href="#criteria">Что важно в арабском</a>
      <a href="#table">Сравнение приложений</a>
      <a href="#who">Кому что подходит</a>
      <a href="#acrab">Как устроен Acrab</a>
      <a href="#faq">Частые вопросы</a>
    </aside>

    <article class="guide-content">
      <section id="why-not">
        <h2>Почему для арабского часто ищут замену Duolingo</h2>
        <p>Duolingo хорошо справляется с привычкой заниматься по пять минут в день, но для русскоязычного ученика в арабском у него есть объективные ограничения:</p>
        <ul class="guide-checklist">
          <li><strong>Нет курса «с русского на арабский».</strong> Приходится переключаться на английский интерфейс и переводить арабские конструкции через второй иностранный язык.</li>
          <li><strong>Мало объяснений грамматики.</strong> Арабский строится на трёхбуквенных корнях, именных и глагольных предложениях, роде числительных и согласовании — без короткой теории до практики правила приходится угадывать.</li>
          <li><strong>Неполные огласовки.</strong> Знаки кратких гласных (<span class="arabic-inline" lang="ar" dir="rtl">حَرَكَاتٌ</span>) быстро исчезают, хотя новичку ещё важно видеть точное чтение слова, например <span class="arabic-inline" lang="ar" dir="rtl">كَتَبَ</span> («он написал») и <span class="arabic-inline" lang="ar" dir="rtl">كُتُبٌ</span> («книги»).</li>
          <li><strong>Ограниченная доступность на Android.</strong> Приложения нет в RuStore, а оплата подписки российскими картами недоступна.</li>
        </ul>
      </section>

      <section id="criteria">
        <h2>На что смотреть при выборе альтернативы</h2>
        <p>При выборе приложения для арабского важнее не число мини-игр, а учебная база. Подробный чек-лист мы разобрали в статье <a href="/arabic-app/">«Как выбрать приложение для изучения арабского»</a>, а здесь выделим пять практических критериев:</p>
        <div class="principle-grid" data-appear-group>
          <div class="card card-plain"><strong>Теория по-русски</strong><p>Короткое объяснение правила перед заданиями экономит недели на поиске ответов по форумам.</p></div>
          <div class="card card-plain"><strong>Полная огласовка</strong><p>На старте каждое арабское слово должно показывать фатху, касру, дамму, сукун и шадду.</p></div>
          <div class="card card-plain"><strong>Озвучка и слух</strong><p>Упражнения на аудирование учат различать близкие звуки (<span class="arabic-inline" lang="ar" dir="rtl">ح</span> и <span class="arabic-inline" lang="ar" dir="rtl">ه</span>, <span class="arabic-inline" lang="ar" dir="rtl">ت</span> и <span class="arabic-inline" lang="ar" dir="rtl">ط</span>).</p></div>
          <div class="card card-plain"><strong>Повторение по интервалам</strong><p>Слова должны возвращаться до того, как сотрутся из памяти, а ошибки — разбираться отдельно.</p></div>
        </div>
      </section>

      <section id="table">
        <h2>Честное сравнение: Acrab, Duolingo, Busuu, Drops, AlifBee и учебники</h2>
        <p>У каждого формата своя сильная сторона. В таблице собраны факты, которые чаще всего влияют на ежедневные занятия с нуля:</p>
        <div class="guide-table-scroll card card-plain" data-appear>
          <table class="guide-table">
            <thead>
              <tr>
                <th scope="col">Инструмент</th>
                <th scope="col">Грамматика на русском</th>
                <th scope="col">Огласовки</th>
                <th scope="col">Озвучка</th>
                <th scope="col">Повторение</th>
                <th scope="col">Доступность</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map(([name, grammar, vowels, audio, repeat, stores]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{grammar}</td>
                  <td>{vowels}</td>
                  <td>{audio}</td>
                  <td>{repeat}</td>
                  <td>{stores}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="guide-note card card-neutral card-warm">
          <strong>Попробуйте стартовый курс без оплаты:</strong> в Acrab первые темы программы с алфавитом, огласовками и упражнениями открыты без ограничения по сроку.
          <div class="hero-downloads"><a class="btn btn-compact" href="/get/">Скачать Acrab бесплатно</a></div>
        </div>
      </section>

      <section id="who">
        <h2>Кому какой вариант подойдёт</h2>
        <div class="decision-list" data-appear-group>
          <div class="card card-plain">
            <strong>Системный старт на русском</strong>
            <ul>
              <li>Если вы учите литературный арабский (<a href="/fusha/">фусху</a>) с нуля или после алфавита — выбирайте Acrab.</li>
              <li>Теория, практика, аудирование, спряжение глаголов и книги Библиотеки собраны в одном месте.</li>
              <li>Не нужен английский язык в качестве посредника.</li>
            </ul>
          </div>
          <div class="card card-plain">
            <strong>Дополнительные тренажёры</strong>
            <ul>
              <li><strong>Drops</strong> удобен как дополнительный визуальный тренажёр отдельных слов по 5 минут в день.</li>
              <li><strong>Duolingo и AlifBee</strong> подойдут тем, кто свободно владеет английским и использует их ради лёгкой игровой разминки.</li>
              <li><strong>Учебники</strong> («Байна ядайк», «аль-Кироату ар-Рашида») лучше всего работают в паре с преподавателем или приложением.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="acrab">
        <h2>Чем Acrab отличается в ежедневной учёбе</h2>
        <p>Acrab создавался специально для русскоязычных учеников, которые учат литературный арабский самостоятельно. Вместо разрозненных карточек в приложении выстроен последовательный маршрут от букв к чтению текстов:</p>
        <ol class="learning-steps compact-steps">
          <li><div><strong>Алфавит, огласовки и первые фразы</strong><p>Вы учите <a href="/arabic-alphabet/">28 букв</a>, соединения, <a href="/arabic-vowels/">огласовки</a> и сразу слышите, как звучат слоги и слова.</p></div></li>
          <li><div><strong>Понятная грамматика перед практикой</strong><p>Каждая новая тема начинается с короткой теории по-русски и только потом проверяется в заданиях на перевод, сборку фразы и выбор формы.</p></div></li>
          <li><div><strong>Интервальное повторение и инструменты</strong><p>Слова возвращаются через 1, 7 и 30 дней; рядом с программой доступны спряжение глаголов, поиск семьи слов по корню, расстановка огласовок и <a href="/ai-arabic-tutor/">ИИ-ассистент</a>.</p></div></li>
          <li><div><strong>Чтение в Библиотеке</strong><p>Когда база готова, можно открыть <a href="/qiraa-rashida/">«аль-Кироату ар-Рашида»</a> с переводом слова по нажатию или скачать учебник <a href="/bayna-yadayk/">«Байна ядайк»</a> для чтения без интернета.</p></div></li>
        </ol>
        <GuideCta title="Начните учить арабский на русском бесплатно" text="Бесплатный старт без ограничения по сроку: алфавит, первые фразы, озвучка, быстрые тренировки, Анки и дневные лимиты ИИ-ассистента." />
      </section>

      <GuideFaq items={faq} />
    </article>
  </div>

  <nav class="related-guides" data-appear-group aria-label="Другие статьи">
    <a href="/arabic-app/"><span>Выбор программы</span><strong>Приложение для изучения арабского →</strong></a>
    <a href="/learn-arabic/"><span>Полный маршрут</span><strong>Как выучить арабский с нуля →</strong></a>
    <a href="/ai-arabic-tutor/"><span>Практика с ИИ</span><strong>ИИ для изучения арабского →</strong></a>
  </nav>
</GuideLayout>
