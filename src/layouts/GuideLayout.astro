---
import GuideShell from "./GuideShell.astro";
import type { GuideMeta } from "../seo/schema";
import type { SeoProps } from "../seo/page-meta";
import "../styles/page-guide.css";

/**
 * Статья: крошки на странице, Article + BreadcrumbList в разметке и нижняя
 * мобильная плашка. Canonical строится из `guide.path`; индексация, `og:type`
 * article и большая карточка в соцсетях — по умолчанию для всех статей.
 */
type Props = Omit<SeoProps, "canonical"> & {
  guide: GuideMeta;
  /** Выбранный раздел шапки: статьи или отдельная вкладка «Клавиатура». */
  section?: "articles" | "keyboard";
  schemaType?: "Article" | "WebPage";
  extraJsonLd?: Record<string, unknown>[];
  stickyCtaText?: string;
};
---

<GuideShell {...Astro.props}>
  <slot name="stage" slot="stage" />
  <slot />
</GuideShell>
