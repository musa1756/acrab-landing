---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { articleSchema, breadcrumbSchema, type GuideMeta } from "../seo/schema";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: "summary" | "summary_large_image";
  csp?: string;
  /** Статья: крошки на странице и Article + BreadcrumbList в разметке. */
  guide: GuideMeta;
}
const { guide, ...props } = Astro.props;
const crumbs = guide.crumbs;
---

<BaseLayout {...props} jsonLd={[articleSchema(guide), breadcrumbSchema(crumbs)]}>
  <a class="skip-link" href="#main">К содержанию</a>
  <Header active="articles" />
  <main id="main" class="guide-page">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      {crumbs.map((crumb, index) => index < crumbs.length - 1 ? (
        <Fragment><a class="chip" href={crumb.path}>{crumb.name}</a><Icon name="caret-right" class="crumb-sep" /></Fragment>
      ) : (
        <span class="chip" aria-current="page">{crumb.name}</span>
      ))}
    </nav>
    <slot />
  </main>
  <Footer variant="guide" />
</BaseLayout>
