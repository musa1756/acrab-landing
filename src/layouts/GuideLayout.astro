---
import PageLayout from "./PageLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { pageUrl } from "../lib/routes";
import { articleSchema, breadcrumbSchema, type GuideMeta } from "../seo/schema";
import type { SeoProps } from "../seo/page-meta";
import "../styles/page-guide.css";

/**
 * Статья: крошки на странице, Article + BreadcrumbList в разметке. Canonical
 * строится из `guide.path`; индексация, `og:type` article и большая карточка
 * в соцсетях — по умолчанию для всех статей.
 */
type Props = Omit<SeoProps, "canonical"> & {
  guide: GuideMeta;
  /** Выбранный раздел шапки: статьи или отдельная вкладка «Клавиатура». */
  section?: "articles" | "keyboard";
};

const {
  guide,
  section = "articles",
  robots = "index, follow, max-image-preview:large",
  ogType = "article",
  twitterCard = "summary_large_image",
  ...seo
} = Astro.props;
---

<PageLayout
  {...seo}
  canonical={pageUrl(guide.path)}
  robots={robots}
  ogType={ogType}
  twitterCard={twitterCard}
  section={section}
  jsonLd={[articleSchema(guide), breadcrumbSchema(guide.crumbs)]}
>
  <!-- Первый экран во всю ширину окна, над крошками: так у клавиатуры. -->
  <slot name="stage" />
  <div class="guide-page">
    <Breadcrumbs crumbs={guide.crumbs} />
    <slot />
  </div>
</PageLayout>
