---
import SeoHead from "../components/SeoHead.astro";
import { BUILD_ID } from "../lib/build-id";
import type { SeoProps } from "../seo/page-meta";
import "../styles/global.css";

type Props = SeoProps & {
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
};

const { bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang="ru" data-build={BUILD_ID}>
  <head>
    <SeoHead {...seo} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="../scripts/fresh-page.ts"></script>
    <script src="../scripts/site-analytics.ts"></script>
    <script src="../scripts/appear.ts"></script>
  </body>
</html>
