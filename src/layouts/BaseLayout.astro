---
import SeoHead from "../components/SeoHead.astro";
import { BUILD_ID } from "../lib/build-id";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  twitterCard?: "summary" | "summary_large_image";
  viewport?: string;
  themeColor?: string | null;
  includeIcons?: boolean;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}

const { bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang="ru" data-build={BUILD_ID}>
  <head>
    <SeoHead {...seo} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script src="../scripts/fresh-page.ts"></script>
    <script src="../scripts/site-analytics.ts"></script>
    <script src="../scripts/appear.ts"></script>
  </body>
</html>
