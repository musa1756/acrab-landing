---
import PageLayout from "./PageLayout.astro";
import type { ServiceNav } from "../lib/routes";
import type { SeoProps } from "../seo/page-meta";

type Props = SeoProps & { variant: ServiceNav };

const { variant, ...seo } = Astro.props;
---

<PageLayout {...seo} nav={variant} mainClass="legal-page"><slot /></PageLayout>
